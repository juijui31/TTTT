javascript:(async function(){const targetUrl=window.location.href,formElement=document.getElementById('_clform'),candidateElements=Array.from(document.querySelectorAll('#_clform button, #_clform a, #_clform input, #_clform .ui-button'));let targetBtn=candidateElements.find(el=>(el.innerText||el.textContent||el.value||el.title||'').trim().includes('調影像'));if(targetBtn&&!targetBtn.id)targetBtn=targetBtn.closest('[id]');if(!targetBtn||!targetBtn.id){alert('未找到「調影像」按鈕');return;}const dynamicSourceId=targetBtn.id,newTab=window.open('about:blank','_blank'),bodyParams=formElement?new URLSearchParams(new FormData(formElement)):new URLSearchParams();bodyParams.set('javax.faces.partial.ajax','true');bodyParams.set('javax.faces.source',dynamicSourceId);bodyParams.set('javax.faces.partial.execute','@all');bodyParams.set(dynamicSourceId,dynamicSourceId);try{const response=await fetch(targetUrl,{method:'POST',headers:{'Accept':'application/xml, text/xml, */*; q=0.01','Content-Type':'application/x-www-form-urlencoded; charset=UTF-8','Faces-Request':'partial/ajax','X-Requested-With':'XMLHttpRequest'},credentials:'include',body:bodyParams.toString()});if(!response.ok)throw new Error('伺服器回應異常');const xmlText=await response.text(),xmlDoc=(new DOMParser()).parseFromString(xmlText,'text/xml'),updatedViewState=xmlDoc.querySelector('update[id*="javax.faces.ViewState"]'),viewStateInput=document.querySelector('input[name="javax.faces.ViewState"]');if(updatedViewState&&updatedViewState.textContent&&viewStateInput)viewStateInput.value=updatedViewState.textContent;const evalNodes=xmlDoc.querySelectorAll('eval');let opened=false;if(evalNodes.length>0){evalNodes.forEach(node=>{const scriptCode=node.textContent.trim(),match=scriptCode.match(/window\.open\(['"]([^'"]+)['"]/);if(match&&match[1]&&newTab){newTab.location.href=(new URL(match[1],window.location.href)).href;opened=true;}});}if(!opened&&newTab)newTab.close();}catch(error){if(newTab)newTab.close();alert('調影像失敗：'+error.message);}})();
