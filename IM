    }
    return { docGroupList: [], clientId: '', errorMessage: lastFail || '查詢失敗', errorType: 'NETWORK', aborted: false };
  }
  async queryAssociatedCases(clientId, options = {}) {
    const signal = options.signal;
    if (!clientId) return [];
    const routes = EndpointMapper.getHistoryEndpoints();
    const headers = { method: 'GET', headers: { 'x-requested-with': 'XMLHttpRequest', accept: 'application/json, */*' }, credentials: 'include' };
    const curDate = new Date().toISOString().slice(0, 10).replace(/-/g, '/');
    const q = '?CL_Serial=&RelatedAcceptNo=&SurveyNo=&ClosedNo=&ClientId=' + encodeURIComponent(String(clientId).trim()) + '&ScanDateTimeStart=&ScanDateTimeEnd=' + curDate + '&includeDel=false';

