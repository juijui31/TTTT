class Crc32Engine {
  static table = null;
  static initializeTable() {
    const table = new Uint32Array(256);
    for (let i = 0; i < 256; i++) {
      let reg = i;
      for (let bit = 0; bit < 8; bit++) reg = (reg & 1) ? (0xEDB88320 ^ (reg >>> 1)) : (reg >>> 1);
      table[i] = reg;
    }
    return table;
  }
  static async compute(dataBytes) {
    if (!Crc32Engine.table) Crc32Engine.table = Crc32Engine.initializeTable();
    let crc = 0xFFFFFFFF;
    const total = dataBytes.length, block = 1024 * 1024;
    for (let i = 0; i < total; i++) {
      crc = (crc >>> 8) ^ Crc32Engine.table[(crc ^ dataBytes[i]) & 0xFF];
      if (i > 0 && i % block === 0) await ByteInspector.delay(0);
    }
    return (crc ^ 0xFFFFFFFF) >>> 0;
  }
}

class ZipArchiveEngine {
  static async compressAndEmit(archiveName, fileList, options = {}) {
    if (!Array.isArray(fileList) || !fileList.length) throw new Error('沒有任何有效檔案可打包');
    const signal = options.signal;
    const encoder = new TextEncoder();
    const payloadParts = [], directoryEntries = [];
    let streamOffset = 0;

    const timeStamp = new Date();
    const clampedYear = ByteInspector.clampValue(timeStamp.getFullYear(), 1980, 2107);
    const dosTime = ((timeStamp.getHours() << 11) | (timeStamp.getMinutes() << 5) | (timeStamp.getSeconds() >> 1)) & 0xFFFF;
    const dosDate = (((clampedYear - 1980) << 9) | ((timeStamp.getMonth() + 1) << 5) | timeStamp.getDate()) & 0xFFFF;

    for (const item of fileList) {
      if (signal && signal.aborted) throw new DOMException('已取消打包作業', 'AbortError');
      if (!item || !item.data || !(item.data instanceof Uint8Array)) continue;

      const safeName = ByteInspector.sanitizeText(item.name) || 'file';
      const encodedName = encoder.encode(safeName);
      const crcValue = await Crc32Engine.compute(item.data);
      const byteLength = item.data.length;

      const headerBuffer = new ArrayBuffer(30 + encodedName.length);
      const headerView = new DataView(headerBuffer);
      headerView.setUint32(0, 0x04034b50, true);
      headerView.setUint16(4, 20, true);
      headerView.setUint16(6, 0x0800, true);
      headerView.setUint16(8, 0, true);
      headerView.setUint16(10, dosTime, true);
      headerView.setUint16(12, dosDate, true);
      headerView.setUint32(14, crcValue, true);
      headerView.setUint32(18, byteLength, true);
      headerView.setUint32(22, byteLength, true);
      headerView.setUint16(26, encodedName.length, true);
      headerView.setUint16(28, 0, true);

      new Uint8Array(headerBuffer).set(encodedName, 30);
      payloadParts.push(new Uint8Array(headerBuffer), item.data);
      directoryEntries.push({ encodedName, crc: crcValue, size: byteLength, offset: streamOffset });
      streamOffset += headerBuffer.byteLength + byteLength;
    }

    let directorySize = 0;
    const dirOffset = streamOffset;
    for (const entry of directoryEntries) {
      const entryBuffer = new ArrayBuffer(46 + entry.encodedName.length);
      const entryView = new DataView(entryBuffer);
      entryView.setUint32(0, 0x02014b50, true);
      entryView.setUint16(4, 20, true);
      entryView.setUint16(6, 20, true);
      entryView.setUint16(8, 0x0800, true);
      entryView.setUint16(10, 0, true);
      entryView.setUint16(12, dosTime, true);
      // ISS-01 修復：將非標準 setUint14 改為標準 setUint16
      entryView.setUint16(14, dosDate, true);
      entryView.setUint32(16, entry.crc, true);
      entryView.setUint32(20, entry.size, true);
      entryView.setUint32(24, entry.size, true);
      entryView.setUint16(28, entry.encodedName.length, true);
      entryView.setUint16(30, 0, true);
      entryView.setUint16(32, 0, true);
      entryView.setUint16(34, 0, true);
      entryView.setUint16(36, 0, true);
      entryView.setUint32(38, 0, true);
      entryView.setUint32(42, entry.offset, true);

      new Uint8Array(entryBuffer).set(entry.encodedName, 46);
      payloadParts.push(new Uint8Array(entryBuffer));
      directorySize += entryBuffer.byteLength;
    }

    const footerBuffer = new ArrayBuffer(22);
    const footerView = new DataView(footerBuffer);
    footerView.setUint32(0, 0x06054b50, true);
    footerView.setUint16(4, 0, true);
    footerView.setUint16(6, 0, true);
    footerView.setUint16(8, directoryEntries.length, true);
    footerView.setUint16(10, directoryEntries.length, true);
    footerView.setUint32(12, directorySize, true);
    footerView.setUint32(16, dirOffset, true);
    footerView.setUint16(20, 0, true);
    payloadParts.push(new Uint8Array(footerBuffer));

    const zipBlobUrl = URL.createObjectURL(new Blob(payloadParts, { type: 'application/zip' }));
    const downloadAnchor = document.createElement('a');
    downloadAnchor.href = zipBlobUrl;
    downloadAnchor.download = (ByteInspector.sanitizeText(archiveName) || 'Download_Files') + '.zip';
    document.body.appendChild(downloadAnchor);
    downloadAnchor.click();
    downloadAnchor.remove();
    setTimeout(() => URL.revokeObjectURL(zipBlobUrl), 5000);
  }
}

