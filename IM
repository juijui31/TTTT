    const clean = encodeURIComponent(String(caseNumber || '').trim());
    const curDate = new Date().toISOString().slice(0, 10).replace(/-/g, '/');
    const qList = [
      'CLACCEPTNO=' + clean,
      'CL_Serial=&RelatedAcceptNo=' + clean + '&SurveyNo=&ClosedNo=&ClientId=&ScanDateTimeStart=&ScanDateTimeEnd=' + curDate + '&includeDel=false'
    ];

    let lastFail = null;
    for (const ep of [routes.primaryList, routes.secondaryList]) {
      for (const params of qList) {
        if (signal?.aborted) return { docGroupList: [], clientId: '', errorType: 'ABORT', aborted: true };
        try {
          const resp = await this.sendRequestWithTimeout(ep + '?' + params, headers, signal);
          if (resp.status === 401 || resp.status === 403) return { docGroupList: [], clientId: '', errorMessage: '登入已逾時', errorType: 'AUTH', aborted: false };
          if (!resp.ok) { lastFail = 'HTTP ' + resp.status; if ([404, 405].includes(resp.status)) continue; return { docGroupList: [], clientId: '', errorMessage: lastFail, errorType: 'HTTP', aborted: false }; }
          const ct = resp.headers.get('content-type') || '';
          if (ct.includes('text/html')) return { docGroupList: [], clientId: '', errorMessage: '登入狀態失效，請重新登入', errorType: 'AUTH', aborted: false };

          let parsed = null;
          try { parsed = await resp.json(); } catch (_) { return { docGroupList: [], clientId: '', errorMessage: '非 JSON 格式', errorType: 'PARSE', aborted: false }; }
          const rawRows = RemoteDataFetcher.parseHierarchyRows(parsed);
          if (!rawRows.length && params.startsWith('CLACCEPTNO')) continue;

          return {
            docGroupList: rawRows.filter(Boolean).map((it, idx) => RemoteDataFetcher.formatRowData(it, idx)),
            clientId: RemoteDataFetcher.parseClientNumber(parsed, rawRows) || '',
            errorMessage: null, errorType: null, aborted: false
          };
        } catch (err) {
          if (RemoteDataFetcher.isAbort(err) || signal?.aborted) return { docGroupList: [], clientId: '', errorType: 'ABORT', aborted: true };
          lastFail = err?.message || String(err);
        }
