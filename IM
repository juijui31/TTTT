  static getFormatCandidates(mime, scope = 'preview') {
    const m = String(mime || '').toLowerCase();
    const hasPdf = m.includes('.pdf') || m.includes('application/pdf');
    const hasPng = m.includes('.png');
    const hasJpg = m.includes('.jpg') || m.includes('jpeg');
    const hasTif = m.includes('.tif') || m.includes('tiff');
    const cand = [];
    const pushU = (ext) => { if (!cand.includes(ext)) cand.push(ext); };
