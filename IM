  static parseHierarchyRows(jsonBody) {
    const candidateKeys = ['aaData', 'list', 'data', 'rows', 'result'];
    const traverse = (node, depth) => {
      if (depth > 4 || node == null) return null;
      if (Array.isArray(node)) {
        if (!node.length) return [];
        if (node.some(it => it && typeof it === 'object' && ('DocumentID' in it || 'docId' in it || 'FormID' in it))) return node;
        for (const it of node.slice(0, 5)) {
          const sub = traverse(it, depth + 1);
          if (Array.isArray(sub)) return sub;
        }
        return [];
      }
      if (typeof node === 'object') {
        for (const k of candidateKeys) {
          if (k in node) {
            const sub = traverse(node[k], depth + 1);
            if (Array.isArray(sub)) return sub;
          }
        }
      }
      return null;
    };
    return traverse(jsonBody, 0) || [];
  }
  static parseClientNumber(jsonBody, records = []) {
    try {
