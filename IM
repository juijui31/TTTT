          const hit = row.IndexKeyValue.find(kv => String(kv?.Key || '').toUpperCase() === 'CLIENTID');
          if (hit?.Value?.trim()) return hit.Value.trim();
        }
        for (const f of ['ClientID', 'CLIENTID', 'clientId', 'IDNO', 'idNo', 'CUSTID', 'custId']) {
          if (row?.[f] && String(row[f]).trim()) return String(row[f]).trim();
