  }
  async acquireSingleImage(item, options = {}) {
    const signal = options.signal;
    const useCache = options.useCache !== false;
    const purpose = options.purpose || 'preview';
    const cacheKey = [item.cacheNamespace || '', purpose, item.docId, item.currentPage, item.totalPage, item.mimeType].join('|');

    if (useCache) {
      const cached = this.fetchCached(cacheKey);
      if (cached) return Object.assign({}, cached, { name: ByteInspector.sanitizeText(item.rawName) + cached.ext });
    }
    if (this.inflightMap.has(cacheKey)) {
      const p = await this.inflightMap.get(cacheKey);
      return Object.assign({}, p, { name: ByteInspector.sanitizeText(item.rawName) + p.ext });
    }

    const self = this;
    const worker = (async () => {
      let failMsg = null, tiffBak = null;
      for (const targetExt of RemoteDataFetcher.getFormatCandidates(item.mimeType, purpose)) {
        const res = await self.retrieveImageStream(item, targetExt, { signal });
        if (res?.data) {
          let rec = Object.assign({}, res.data, { previewable: true, originalRequestedExt: targetExt });
          if (purpose === 'preview' && rec.ext === '.tif') {
            tiffBak = rec;
            try {
              const png = await TiffDecoderService.convertToPngBytes(rec.data);
              rec = { data: png, ext: '.png', previewable: true, sourceExt: '.tif', sourceData: tiffBak.data };
            } catch (ce) { failMsg = ce?.message || 'TIFF 轉檔失敗'; continue; }
          }
          rec.name = ByteInspector.sanitizeText(item.rawName) + rec.ext;
          if (useCache) self.storeCache(cacheKey, Object.assign({}, rec));
          return rec;
        }
        failMsg = res?.error || failMsg;
        if (res?.error?.startsWith('AUTH_')) { const se = new Error('登入狀態失效'); se.code = 'AUTH'; throw se; }
        if (res?.retry === false) break;
      }
      if (purpose === 'preview' && tiffBak) {
        const fb = Object.assign({}, tiffBak, { previewable: false, name: ByteInspector.sanitizeText(item.rawName) + '.tif' });
        if (useCache) self.storeCache(cacheKey, Object.assign({}, fb));
        return fb;
      }
      const ex = new Error(failMsg || '讀取失敗'); ex.code = failMsg || 'FAILED'; throw ex;
    })().finally(() => self.inflightMap.delete(cacheKey));

    this.inflightMap.set(cacheKey, worker);
    const finalRec = await worker;
    return Object.assign({}, finalRec, { name: ByteInspector.sanitizeText(item.rawName) + finalRec.ext });
  }
}

class FocusTrapEngine {
  constructor(root) {
    this.root = root;
    this.active = false;
    this.onKeyDown = this.onKeyDown.bind(this);
  }
  enable() { if (!this.active) { this.active = true; document.addEventListener('keydown', this.onKeyDown, true); } }
  disable() { if (this.active) { this.active = false; document.removeEventListener('keydown', this.onKeyDown, true); } }
  onKeyDown(e) {
    if (e.key !== 'Tab' || !this.active || !this.root) return;
    const nodes = Array.from(this.root.querySelectorAll('a[href],button:not([disabled]),textarea,input,select,[tabindex]:not([tabindex="-1"])'))
      .filter(n => !n.hasAttribute('disabled') && (n.offsetParent !== null || n.getClientRects().length > 0));
    if (!nodes.length) return;
    const first = nodes[0], last = nodes[nodes.length - 1];
    if (e.shiftKey && document.activeElement === first) { last.focus(); e.preventDefault(); }
    else if (!e.shiftKey && document.activeElement === last) { first.focus(); e.preventDefault(); }
  }
}

