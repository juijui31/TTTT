  toggleMaximize() {
    this.isMaximized = !this.isMaximized;
    const btnMax = $id('btn_max');
    if (this.isMaximized) {
      this.windowCard.classList.add('iw-maximized');
      this.sidebarNode.style.display = 'flex';
      if (this.previewController?.currentDocument && this.resizerBar) this.resizerBar.style.display = 'block';
      if (btnMax) btnMax.textContent = '🗗 還原';
    } else {
      this.windowCard.classList.remove('iw-maximized');
      this.sidebarNode.style.display = 'flex';
      if (this.previewController?.currentDocument && this.resizerBar) this.resizerBar.style.display = 'block';
      if (btnMax) btnMax.textContent = '⛶ 滿版';
      this.recenterWindow();
    }
    if (this.previewController) this.previewController.handleLayoutRepaint();
  }

  recenterWindow() {
    if (!this.windowCard || this.isMaximized) return;
    requestAnimationFrame(() => {
      const w = this.windowCard.offsetWidth || UI_CONFIG.CARD_WIDTH_DEFAULT;
      const h = this.windowCard.offsetHeight || (window.innerHeight * UI_CONFIG.CARD_HEIGHT_RATIO);
      const px = Math.max(10, Math.round((window.innerWidth - w) / 2));
      const py = Math.max(10, Math.round((window.innerHeight - h) / 2));
      this.windowCard.style.left = px + 'px';
      this.windowCard.style.top = py + 'px';
      this.savedWindowCoords = { left: px, top: py };
    });
  }

  toggleViewportExpansion() {
    const isExp = Boolean(this.previewController?.currentDocument || this.resizerBar?.style.display === 'block');
    if (isExp) {
      if (this.previewController?.currentDocument) this.previewController.closeViewport();
      else this.applyLayoutState(false);
    } else {
      if (this.state.docGroupList.length > 0) {
        const isMulti = this.state.docGroupList.length > 1;
        this.listController.highlightedDocKey = isMulti ? '__ALL__' : String(this.state.docGroupList[0].rowKey);
        this.listController.updateRowHighlight();
        this.previewController.displayDocument(isMulti ? ByteInspector.buildVirtualAllCaseDocument(this.state.docGroupList) : this.state.docGroupList[0], 1);
      } else {
        this.applyLayoutState(true);
      }
    }
  }

  applyLayoutState(isViewportOpen) {
    if (!this.windowCard || !this.sidebarNode || !this.resizerBar) return;
    const toggleBtn = $id('btn_expand_toggle');

    if (isViewportOpen) {
      if (!this.isMaximized) {
        this.windowCard.style.width = UI_CONFIG.CARD_WIDTH_EXPANDED_VW + 'vw';
        this.windowCard.style.maxWidth = '1740px';
      }
      const stW = Number(StorageCoordinator.read().leftWidth);
      const w = Number.isFinite(stW) ? ByteInspector.clampValue(stW, UI_CONFIG.SIDEBAR_WIDTH_MIN, UI_CONFIG.SIDEBAR_WIDTH_MAX) : UI_CONFIG.SIDEBAR_WIDTH_DEFAULT;
      this.sidebarNode.style.width = w + 'px';
      this.sidebarNode.style.flex = '0 0 ' + w + 'px';
      if (!this.isMaximized) this.resizerBar.style.display = 'block';

      if (toggleBtn) { toggleBtn.textContent = '🗗 收合'; toggleBtn.className = 'iw-btn-subtle'; }
    } else {
      if (!this.isMaximized) {
        this.windowCard.style.width = `min(${UI_CONFIG.CARD_WIDTH_DEFAULT}px, 96vw)`;
        this.windowCard.style.maxWidth = 'calc(100vw - 20px)';
      }
      this.sidebarNode.style.width = '100%';
      this.sidebarNode.style.flex = '1 1 auto';
      this.resizerBar.style.display = 'none';

      if (toggleBtn) { toggleBtn.textContent = '⛶ 展開'; toggleBtn.className = 'iw-btn-primary'; }
    }
    this.recenterWindow();
    if (this.previewController) this.previewController.handleLayoutRepaint();
  }

  setupDragInteractions() {
    const card = this.windowCard, header = $id('header'), resizer = this.resizerBar, sidebar = this.sidebarNode, ball = this.floatingBall;

    let initL = 0, initT = 0;
    this.disposers.push(bindDraggable({
      handle: header,
      onStart: (e) => {
        if (this.isMaximized || e.target.closest('button,input,select,a,.iw-badge')) return false;
        initL = card.offsetLeft; initT = card.offsetTop;
      },
      onMove: (dx, dy) => {
        const curL = ByteInspector.clampValue(initL + dx, 0, Math.max(0, window.innerWidth - card.offsetWidth));
        const curT = ByteInspector.clampValue(initT + dy, 0, Math.max(0, window.innerHeight - card.offsetHeight));
        card.style.left = curL + 'px'; card.style.top = curT + 'px';
        this.savedWindowCoords = { left: curL, top: curT };
      }
    }));

    let initW = 0;
    this.disposers.push(bindDraggable({
      handle: resizer,
      onStart: () => {
        initW = sidebar.getBoundingClientRect().width;
        resizer.classList.add('dragging');
      },
      onMove: (dx) => {
        const maxW = Math.min(UI_CONFIG.SIDEBAR_WIDTH_MAX, card.getBoundingClientRect().width - 360);
        const nextW = ByteInspector.clampValue(initW + dx, UI_CONFIG.SIDEBAR_WIDTH_MIN, maxW);
        sidebar.style.width = nextW + 'px';
        sidebar.style.flex = '0 0 ' + nextW + 'px';
        if (this.previewController) this.previewController.handleLayoutRepaint();
      },
      onEnd: () => {
        resizer.classList.remove('dragging');
        StorageCoordinator.write({ leftWidth: Math.round(sidebar.getBoundingClientRect().width) });
        if (this.previewController) this.previewController.handleLayoutRepaint();
      }
    }));

    let bInitL = 0, bInitT = 0, bMoved = false;
    this.disposers.push(bindDraggable({
      handle: ball,
      onStart: () => {
        bMoved = false;
        const r = ball.getBoundingClientRect();
        bInitL = r.left; bInitT = r.top;
      },
      onMove: (dx, dy) => {
        if (Math.hypot(dx, dy) > 8) bMoved = true;
        ball.style.left = ByteInspector.clampValue(bInitL + dx, 10, window.innerWidth - UI_CONFIG.BALL_SIZE - 10) + 'px';
        ball.style.top = ByteInspector.clampValue(bInitT + dy, 10, window.innerHeight - UI_CONFIG.BALL_SIZE - 10) + 'px';
        ball.style.right = 'auto'; ball.style.bottom = 'auto';
      },
      onEnd: () => {
        if (bMoved) {
          const r = ball.getBoundingClientRect();
          StorageCoordinator.write({ ballLeft: Math.round(r.left), ballTop: Math.round(r.top) });
        } else {
          this.restoreFromBall();
        }
      }
    }));
  }

  renderShortcutList() {
    const listNode = $id('shortcut_list');
    if (!listNode) return;
    listNode.innerHTML = Object.entries(SHORTCUT_TITLES).map(([action, title]) => {
      const assigned = this.activeShortcuts[action] || '';
      const rec = this.bindingAction === action;
      return `<div class="iw-shortcut-row"><span style="color:var(--iw-text-main);font-weight:700;">${ByteInspector.escapeXml(title)}</span><button class="iw-key-btn ${rec?'recording':''}" data-action="${action}" type="button">${rec ? '請按鍵...' : (ByteInspector.formatKeyBadge(assigned) || '未設定')}</button></div>`;
    }).join('');

    listNode.querySelectorAll('.iw-key-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        this.bindingAction = btn.dataset.action;
        this.renderShortcutList();
      });
    });
  }

  async start() {
    const initialCase = this.renderModalDom();
    this.recenterWindow();

    this.trapEngine = new FocusTrapEngine(this.modalWrapper);
    this.trapEngine.enable();
    this.setupDragInteractions();

    this.previewController = new PreviewCanvasController(
      this.state, this.fetcher, this.modalWrapper, $id('right_panel'),
      (doc, page) => this.previewController.displayDocument(doc, page),
      (open) => this.applyLayoutState(open)
    );

    this.listController = new CaseListController(
      this.state, this.fetcher,
      (doc, page) => {
        this.previewController.lastActiveElement = document.activeElement;
        this.previewController.displayDocument(doc, page);
      },
      (hasSel) => {
        ['start_pdf', 'start_zip'].forEach(id => { const b = $id(id); if (b && !this.batchAbortCtrl) b.disabled = !hasSel; });
      },
      (rawQ) => { const bg = $id('case_badge'); if (bg) bg.textContent = rawQ; }
    );

    this.bindWindowEvents();
    if (initialCase) await this.listController.executeSearch(initialCase);
  }

  bindWindowEvents() {
    $id('btn_close')?.addEventListener('click', () => this.destroy());
    $id('btn_min')?.addEventListener('click', () => this.minimizeToBall());
    $id('btn_max')?.addEventListener('click', () => this.toggleMaximize());
    $id('btn_expand_toggle')?.addEventListener('click', () => this.toggleViewportExpansion());

    const sDlg = $id('shortcut_dialog');
    $id('btn_shortcut_mgr')?.addEventListener('click', () => { sDlg?.classList.add('open'); this.bindingAction = null; this.renderShortcutList(); });
    $id('close_shortcut_dlg')?.addEventListener('click', () => { sDlg?.classList.remove('open'); this.bindingAction = null; });
    $id('reset_shortcuts')?.addEventListener('click', () => {
      this.activeShortcuts = Object.assign({}, INITIAL_SHORTCUTS);
      StorageCoordinator.write({ shortcuts: this.activeShortcuts });
      this.bindingAction = null;
      this.renderShortcutList();
      this.previewController?.renderShortcutLegend();
    });

    $id('btn_theme')?.addEventListener('click', () => {
      this.activeTheme = this.activeTheme === 'dark' ? 'light' : 'dark';
      this.modalWrapper.setAttribute('data-theme', this.activeTheme);
      $id('btn_theme').textContent = this.activeTheme === 'dark' ? '☀️' : '🌙';
      StorageCoordinator.write({ theme: this.activeTheme });
    });

    const inpCase = $id('input_caseno'), btnClr = $id('btn_clear_caseno');
    inpCase?.addEventListener('input', () => { if (btnClr) btnClr.style.display = inpCase.value.trim() ? 'block' : 'none'; });
    inpCase?.addEventListener('keydown', (e) => { if (e.key === 'Enter') this.listController.executeSearch(inpCase.value.trim()); });
    btnClr?.addEventListener('click', () => { inpCase.value = ''; btnClr.style.display = 'none'; inpCase.focus(); });
    $id('btn_search')?.addEventListener('click', () => { if (inpCase?.value.trim()) this.listController.executeSearch(inpCase.value.trim()); });

    $id('start_pdf')?.addEventListener('click', () => this.executeBatchOperation('pdf'));
    $id('start_zip')?.addEventListener('click', () => this.executeBatchOperation('zip'));
    $id('cancel_batch')?.addEventListener('click', () => this.abortBatchTask('已取消作業'));
    $id('retry_failed')?.addEventListener('click', () => { if (this.failedQueue.length && this.failedBatchMode) this.executeBatchOperation(this.failedBatchMode, this.failedQueue.slice()); });
    $id('failed_center_btn')?.addEventListener('click', () => { const fc = $id('failed_center'); if (fc) fc.style.display = 'block'; });
    $id('failed_center_close')?.addEventListener('click', () => { const fc = $id('failed_center'); if (fc) fc.style.display = 'none'; });

    const onKey = (e) => {
      if (this.bindingAction) {
        e.preventDefault(); e.stopPropagation();
        if (e.key === 'Escape') { this.bindingAction = null; this.renderShortcutList(); return; }
        this.activeShortcuts[this.bindingAction] = e.key;
        StorageCoordinator.write({ shortcuts: this.activeShortcuts });
        this.bindingAction = null;
        this.renderShortcutList();
        this.previewController?.renderShortcutLegend();
        return;
      }

      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
        if (!['INPUT', 'SELECT', 'TEXTAREA'].includes(e.target?.tagName)) {
          e.preventDefault();
          this.previewController?.undoLastAction();
          return;
        }
      }

      if (e.key === 'Delete' || e.key === 'Backspace') {
        if (!['INPUT', 'SELECT', 'TEXTAREA'].includes(e.target?.tagName) && !e.target?.isContentEditable) {
          if (this.previewController?.selectedAnnotation) {
            e.preventDefault();
            this.previewController.deleteSelectedAnnotation();
            return;
          }
        }
      }

      if (e.key === 'Escape') {
        if (sDlg?.classList.contains('open')) { sDlg.classList.remove('open'); return; }
        const cDlg = $id('confirm_dialog');
        if (cDlg && cDlg.style.display === 'flex') { this.previewController?.confirmResolver?.(false); cDlg.style.display = 'none'; return; }
        const pop = $id('filter_popover');
        if (pop && !pop.hidden) { pop.hidden = true; return; }
        if (this.previewController?.isSnipMode || this.previewController?.activeTool !== 'view' || this.previewController?.selectedAnnotation) {
          this.previewController.toggleSnipMode(false);
          this.previewController.setDrawingTool('view');
          this.previewController.selectedAnnotation = null;
          this.previewController.redrawCurrentAnnotations();
          return;
        }
        const exp = $id('export_menu'); if (exp && !exp.hidden) { exp.hidden = true; return; }
        if (this.previewController?.currentDocument && this.previewController.currentMode === 'thumb') { $id('tab_preview')?.click(); return; }
        if (this.previewController?.currentDocument) { this.previewController.closeViewport(); return; }
        this.destroy();
        return;
      }

      if (['INPUT', 'SELECT', 'TEXTAREA'].includes(e.target?.tagName) || e.target?.isContentEditable) return;
      const match = (act) => this.activeShortcuts[act] ? e.key.toLowerCase() === this.activeShortcuts[act].toLowerCase() : false;

      if (match('prevPage')) this.previewController?.renderPage(this.previewController.activePageIndex - 1);
      else if (match('nextPage')) this.previewController?.renderPage(this.previewController.activePageIndex + 1);
      else if (match('rotateLeft')) this.previewController?.modifyRotation(this.previewController.activePageIndex, -90);
      else if (match('rotateRight')) this.previewController?.modifyRotation(this.previewController.activePageIndex, 90);
      else if (match('fitPage')) this.previewController?.setFitPage();
      else if (match('zoomIn')) this.previewController?.stepZoom(25);
      else if (match('zoomOut')) this.previewController?.stepZoom(-25);
      else if (match('snipImage')) this.previewController?.toggleSnipMode();
      else if (match('copyImage')) this.previewController?.copyImageToClipboard();
      else if (match('downloadSingle')) this.previewController?.downloadRenderedPage();
      else if (match('toggleOrient')) $id('toggle_hud_orient')?.click();
    };

    document.addEventListener('keydown', onKey);
    this.disposers.push(() => document.removeEventListener('keydown', onKey));
  }

  minimizeToBall() {
    if (this.modalWrapper) this.modalWrapper.style.display = 'none';
    if (this.floatingBall) this.floatingBall.style.display = 'flex';
    this.trapEngine?.disable();
  }

  restoreFromBall() {
    if (this.floatingBall) this.floatingBall.style.display = 'none';
    if (this.modalWrapper) this.modalWrapper.style.display = 'block';
    this.recenterWindow();
    this.trapEngine?.enable();
  }

  abortBatchTask(reason = '已取消') {
    if (this.batchAbortCtrl) { try { this.batchAbortCtrl.abort(); } catch (_) {} this.batchAbortCtrl = null; }
    this.setBatchRunningState(false);
    const sNode = $id('batch_status_text');
    if (sNode) sNode.textContent = reason;
  }

  setBatchRunningState(running) {
    ['start_pdf', 'start_zip'].forEach(id => { const b = $id(id); if (b) b.disabled = running; });
    const cBtn = $id('cancel_batch');
    if (cBtn) cBtn.style.display = running ? 'block' : 'none';
  }

  async executeBatchOperation(mode, customQueue = null) {
    this.abortBatchTask('');
    const queue = (Array.isArray(customQueue) && customQueue.length ? customQueue : this.listController.collectSelectedQueue()).map(t => Object.assign({}, t, { cacheNamespace: this.state.currentCaseNoRaw }));
    if (!queue.length) return;

    const pBar = $id('batch_progress_bar'), sTxt = $id('batch_status_text'), pTxt = $id('batch_percent_text');
    $id('retry_failed') && ($id('retry_failed').style.display = 'none');
    $id('failed_center_btn') && ($id('failed_center_btn').style.display = 'none');

    this.batchAbortCtrl = new AbortController();
    const sig = this.batchAbortCtrl.signal;
    let finished = 0;
    const failures = [];

    const updateProg = () => {
      const pct = Math.round((finished / queue.length) * 100);
      if (pBar) { pBar.style.width = pct + '%'; pBar.style.background = 'var(--iw-primary)'; }
      if (pTxt) pTxt.textContent = pct + '%';
      if (sTxt) sTxt.textContent = `匯出處理中 (${finished}/${queue.length})`;
    };
    this.setBatchRunningState(true);

    try {
      if (mode === 'pdf') {
        const pw = window.open('', '_blank');
        if (pw) pw.document.write('<html><body style="font-family:sans-serif;padding:30px">批次讀取組織列印中...</body></html>');

        const fetchResults = await ByteInspector.poolExecutor(SYSTEM_LIMITS.EXPORT_CONCURRENCY, queue, async (item) => {
          try {
            const fData = await this.fetcher.acquireSingleImage(item, { signal: sig, useCache: true });
            finished++; updateProg();
            return { task: item, file: fData };
          } catch (err) {
            if (!RemoteDataFetcher.isAbort(err) && !sig.aborted) failures.push(Object.assign({}, item, { error: err?.message || '讀取失敗' }));
            finished++; updateProg();
            return null;
          }
        });

        if (sig.aborted) { pw?.close(); return; }
        const validPairs = fetchResults.map(r => r.status === 'fulfilled' ? r.value : null).filter(Boolean);
        const transformed = [];

        for (const pair of validPairs) {
          if (sig.aborted) { pw?.close(); return; }
          const adj = this.previewController?.resolveAdjustments(pair.task.rowKey, pair.task.currentPage) || {};
          const pk = this.previewController?.formatAdjustKey(pair.task.rowKey, pair.task.currentPage) || '';
          transformed.push(await RasterProcessingEngine.transform(
            pair.file, adj, this.previewController?.pageAnnotationsMap.get(pk) || [], this.previewController?.pageLocalEnhanceMap.get(pk) || []
          ));
        }

        if (sig.aborted) { pw?.close(); return; }
        const tpl = PrintDocumentEngine.composePrintTemplate(this.state.currentCaseNoSafe + '_批次列印', transformed);
        if (pw && !pw.closed) {
          pw.document.open();
          pw.document.write(tpl.htmlContent);
          pw.document.close();
        }
      } else {
        const fetchResults = await ByteInspector.poolExecutor(SYSTEM_LIMITS.EXPORT_CONCURRENCY, queue, async (item) => {
          try {
            return await this.fetcher.acquireSingleImage(item, { signal: sig, useCache: true, purpose: 'original' });
          } catch (err) {
            if (!RemoteDataFetcher.isAbort(err) && !sig.aborted) failures.push(Object.assign({}, item, { error: err?.message || '讀取失敗' }));
            return null;
          } finally { finished++; updateProg(); }
        });
        const files = fetchResults.map(r => r.status === 'fulfilled' ? r.value : null).filter(Boolean);
        if (!sig.aborted && files.length) {
          await ZipArchiveEngine.compressAndEmit(this.state.currentCaseNoSafe + '_全案打包', files, { signal: sig });
        }
      }
    } finally {
      this.setBatchRunningState(false);
      this.batchAbortCtrl = null;
    }

    if (failures.length) {
      this.failedQueue = failures;
      this.failedBatchMode = mode;
      $id('retry_failed') && ($id('retry_failed').style.display = 'block');
      $id('failed_center_btn') && ($id('failed_center_btn').style.display = 'block');
      const fcList = $id('failed_center_list');
      if (fcList) {
        fcList.innerHTML = failures.map(f => `<div style="font-size:11px;color:var(--iw-danger);padding:4px 0;border-bottom:1px solid var(--iw-border-subtle);font-weight:700;">[${ByteInspector.escapeXml(f.formName)}] 第 ${f.currentPage} 頁：${ByteInspector.escapeXml(f.error)}</div>`).join('');
      }
      if (sTxt) sTxt.textContent = `完成；成功 ${finished - failures.length} 頁，失敗 ${failures.length} 頁`;
    } else {
      if (sTxt) sTxt.textContent = '作業全數完成';
      setTimeout(() => {
        if (pBar) { pBar.style.width = '100%'; pBar.style.background = 'var(--iw-success)'; }
        if (pTxt) pTxt.textContent = '100%';
        if (sTxt) { sTxt.textContent = '預載完成 100%'; sTxt.style.color = 'var(--iw-success)'; }
      }, 2000);
    }
  }

  destroy() {
    this.abortBatchTask('');
    while (this.disposers.length) { try { this.disposers.pop()(); } catch (_) {} }
    this.trapEngine?.disable();
    this.previewController?.closeViewport();
    this.listController?.destroy();
    this.fetcher.cancelAllPending();
    this.fetcher.purgeCache();

    $id('style')?.remove();
    this.modalWrapper?.remove();
    this.floatingBall?.remove();
    if (window[GLOBAL_GUARD_KEY]?.instance === this) delete window[GLOBAL_GUARD_KEY];
  }
}

const app = new ImageWorkbenchApplication();
window[GLOBAL_GUARD_KEY] = { instance: app, destroy: () => app.destroy() };
app.start().catch((err) => console.error('ImageWorkbench 啟動失敗:',err));})();
