class TiffDecoderService {
  static async convertToPngBytes(tiffBytes) {
    if (!(tiffBytes instanceof Uint8Array)) throw new TypeError('TIFF 資料格式錯誤');
    const sourceBlob = new Blob([tiffBytes], { type: 'image/tiff' });

    if (typeof createImageBitmap === 'function') {
      try {
        const bmp = await createImageBitmap(sourceBlob);
        if (bmp.width * bmp.height > SYSTEM_LIMITS.MAX_TIFF_PIXELS) {
          bmp.close(); throw new Error('TIFF 圖片尺寸過大');
        }
        const { canvas, ctx } = createCanvas(bmp.width, bmp.height);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(bmp, 0, 0);
        bmp.close();
        const blob = await canvasToBlob(canvas, 'image/png');
        return new Uint8Array(await blob.arrayBuffer());
      } catch (_) {}
    }

    if (window.UTIF && typeof window.UTIF.decode === 'function') {
      const buf = ByteInspector.extractArrayBuffer(tiffBytes);
      const ifds = window.UTIF.decode(buf);
      if (!ifds || !ifds.length) throw new Error('TIFF 不含影像');
      window.UTIF.decodeImage(buf, ifds[0]);
      const w = Number(ifds[0].width) || 0, h = Number(ifds[0].height) || 0;
      if (!w || !h || w * h > SYSTEM_LIMITS.MAX_TIFF_PIXELS) throw new Error('TIFF 尺寸超限');

      const rgba = window.UTIF.toRGBA8(ifds[0]);
      const { canvas, ctx } = createCanvas(w, h);
      const imgData = ctx.createImageData(w, h);
      imgData.data.set(rgba);
      ctx.putImageData(imgData, 0, 0);
      const blob = await canvasToBlob(canvas, 'image/png');
      return new Uint8Array(await blob.arrayBuffer());
    }
    throw new Error('目前環境無原生 TIFF 解碼支援');
  }
}

class RasterProcessingEngine {
  static applyPixelEnhancement(ctx, width, height, rect, mode, intensity = 100) {
    const rx = Math.max(0, Math.min(width - 1, Math.round(rect.x)));
    const ry = Math.max(0, Math.min(height - 1, Math.round(rect.y)));
    const rw = Math.max(1, Math.min(width - rx, Math.round(rect.w)));
    const rh = Math.max(1, Math.min(height - ry, Math.round(rect.h)));

    let imgData = null;
    try { imgData = ctx.getImageData(rx, ry, rw, rh); } catch (_) { return; }
    const d = imgData.data;
    const factor = ByteInspector.clampValue(intensity / 100, 0.2, 1);
    const feather = Math.min(10, Math.floor(Math.min(rw, rh) / 4));

    for (let y = 0; y < rh; y++) {
      for (let x = 0; x < rw; x++) {
        const idx = (y * rw + x) * 4;
        let r = d[idx], g = d[idx + 1], b = d[idx + 2];
        const lum = 0.299 * r + 0.587 * g + 0.114 * b;
        let tr = r, tg = g, tb = b;

        if (mode === 'darken') {
          if (lum < 210) {
            const mult = 1 - (factor * 0.55 * (1 - lum / 255));
            tr = Math.max(0, r * mult); tg = Math.max(0, g * mult); tb = Math.max(0, b * mult);
          }
        } else if (mode === 'clear') {
          if (lum > 168 - (factor * 25)) {
            tr = 255; tg = 255; tb = 255;
          } else {
            tr = Math.max(0, r * 0.65); tg = Math.max(0, g * 0.65); tb = Math.max(0, b * 0.65);
          }
        } else if (mode === 'brighten') {
          const boost = (255 - lum) * factor * 0.5;
          tr = Math.min(255, r + boost); tg = Math.min(255, g + boost); tb = Math.min(255, b + boost);
        }

        let edgeAlpha = 1;
        if (feather > 0) {
          const minDist = Math.min(x, rw - 1 - x, y, rh - 1 - y);
          if (minDist < feather) edgeAlpha = minDist / feather;
        }
        d[idx] = Math.round(r + (tr - r) * edgeAlpha);
        d[idx + 1] = Math.round(g + (tg - g) * edgeAlpha);
        d[idx + 2] = Math.round(b + (tb - b) * edgeAlpha);
      }
    }
    ctx.putImageData(imgData, rx, ry);
  }

  static drawAnnotationsToContext(ctx, annotations = []) {
    if (!Array.isArray(annotations) || !annotations.length) return;
    ctx.save();
    for (const ann of annotations) {
      if (!ann) continue;
      ctx.strokeStyle = ann.color || '#ef4444';
      ctx.fillStyle = ann.color || '#ef4444';
      ctx.lineWidth = ann.strokeWidth || 4;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      if (ann.type === 'rect' && ann.rect) {
        ctx.strokeRect(ann.rect.x, ann.rect.y, ann.rect.w, ann.rect.h);
      } else if (ann.type === 'pen' && Array.isArray(ann.points) && ann.points.length > 1) {
        ctx.beginPath();
        ctx.moveTo(ann.points[0].x, ann.points[0].y);
        for (let i = 1; i < ann.points.length; i++) ctx.lineTo(ann.points[i].x, ann.points[i].y);
        ctx.stroke();
      } else if (ann.type === 'text' && ann.text) {
        ctx.font = `bold ${ann.fontSize || 22}px sans-serif`;
        ctx.textBaseline = 'top';
        ctx.fillText(ann.text, ann.x, ann.y);
      }
    }
    ctx.restore();
  }

  static renderComposedLayers(ctx, width, height, annotations = [], localEnhancements = []) {
    for (const loc of localEnhancements) {
      RasterProcessingEngine.applyPixelEnhancement(ctx, width, height, loc.rect, loc.mode, loc.intensity);
    }
    RasterProcessingEngine.drawAnnotationsToContext(ctx, annotations);
  }

  static async transform(sourceRecord, adjustments = {}, annotations = [], localEnhancements = []) {
    if (!sourceRecord || !sourceRecord.data || !(sourceRecord.data instanceof Uint8Array)) return sourceRecord;
    const ext = String(sourceRecord.ext || '.jpg').toLowerCase();
    if (!['.jpg', '.jpeg', '.png'].includes(ext)) return sourceRecord;

    const angle = (((Number(adjustments.rotation) || 0) % 360) + 360) % 360;
    const b = Number.isFinite(Number(adjustments.brightness)) ? Number(adjustments.brightness) : 100;
    const c = Number.isFinite(Number(adjustments.contrast)) ? Number(adjustments.contrast) : 100;
    const s = Number.isFinite(Number(adjustments.saturate)) ? Number(adjustments.saturate) : 100;
    const sh = Number.isFinite(Number(adjustments.sharpness)) ? Number(adjustments.sharpness) : 0;
    const g = Number.isFinite(Number(adjustments.grayscale)) ? Number(adjustments.grayscale) : 0;
    const inv = Number.isFinite(Number(adjustments.invert)) ? Number(adjustments.invert) : 0;

    const hasAdj = (angle !== 0 || b !== 100 || c !== 100 || s !== 100 || sh !== 0 || g !== 0 || inv !== 0);
    const hasLocal = Array.isArray(localEnhancements) && localEnhancements.length > 0;
    const hasAnn = Array.isArray(annotations) && annotations.length > 0;

    if (!hasAdj && !hasLocal && !hasAnn) return sourceRecord;

    const objUrl = URL.createObjectURL(new Blob([sourceRecord.data], { type: ByteInspector.extToMime(ext) }));
    try {
      const img = await new Promise((resolve, reject) => {
        const el = new Image();
        el.onload = () => resolve(el);
        el.onerror = () => reject(new Error('影像解碼失敗'));
        el.src = objUrl;
      });

      const swap = angle === 90 || angle === 270;
      const { canvas, ctx } = createCanvas(swap ? img.height : img.width, swap ? img.width : img.height, ext === '.png');
      if (ext !== '.png') { ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, canvas.width, canvas.height); }

      ctx.save();
      ctx.translate(canvas.width / 2, canvas.height / 2);
      ctx.rotate(angle * Math.PI / 180);
      ctx.filter = `brightness(${b}%) contrast(${c + sh * 20}%) saturate(${s}%) grayscale(${g}%) invert(${inv}%)`;
      ctx.drawImage(img, -img.width / 2, -img.height / 2);
      ctx.restore();

      RasterProcessingEngine.renderComposedLayers(ctx, canvas.width, canvas.height, annotations, localEnhancements);

      const targetMime = ext === '.png' ? 'image/png' : 'image/jpeg';
      const targetExt = ext === '.png' ? '.png' : '.jpg';
      const renderedBlob = await canvasToBlob(canvas, targetMime, 0.98);

      return Object.assign({}, sourceRecord, {
        data: new Uint8Array(await renderedBlob.arrayBuffer()),
        ext: targetExt,
        name: String(sourceRecord.name || 'page').replace(new RegExp('\\.(jpe?g|png)$', 'i'), targetExt)
      });
    } finally {
      URL.revokeObjectURL(objUrl);
    }
  }
}

class RemoteDataFetcher {
