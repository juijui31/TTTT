    this.pageAdjustmentMap.set(key, Object.assign({}, this.pageAdjustmentMap.get(key) || {}, { rotation: (((cur + delta) % 360) + 360) % 360 }));
    if (pNo === this.activePageIndex) {
      this.refreshAdjustInputs();
      this.syncCanvasStyles(pNo);
      requestAnimationFrame(() => this.triggerAutoFit(pNo));
    }
  }

  updateZoom(pNo, zoomVal, isManual = true) {
    const clamped = ByteInspector.clampValue(Number(zoomVal) || 100, UI_CONFIG.ZOOM_MIN, UI_CONFIG.ZOOM_MAX);
    this.pageZoomMap[pNo] = clamped;
    if (isManual) {
      this.globalFitMode = null;
      this.pageFitModeMap[pNo] = null;
    }
    this.syncCanvasStyles(pNo);
    if (pNo === this.activePageIndex) {
      const lbl = this.findNode('zoom_label');
      if (lbl) lbl.textContent = Math.round(clamped) + '%';
    }
  }

  stepZoom(delta) { this.updateZoom(this.activePageIndex, (this.pageZoomMap[this.activePageIndex] || 100) + delta, true); }

  queryNaturalDimensions(pNo) {
    const img = this.findNode('page_img');
    if (!img?.naturalWidth || !img?.naturalHeight || pNo !== this.activePageIndex) return null;
    const { targetDoc, targetPageNo } = PreviewCanvasController.mapPageTarget(this.currentDocument, pNo);
    const angle = this.resolveAdjustments(targetDoc?.rowKey, targetPageNo).rotation || 0;
    const isRot = angle === 90 || angle === 270;
    return { width: isRot ? img.naturalHeight : img.naturalWidth, height: isRot ? img.naturalWidth : img.naturalHeight };
  }

  calculateViewportBounds() {
    const wrap = this.findNode('img_wrap');
    if (!wrap) return null;
    const r = wrap.getBoundingClientRect();
    return { width: Math.max(1, r.width - 30), height: Math.max(1, r.height - 30) };
  }

  setFitWidth(pNo = this.activePageIndex, isManual = true) {
    if (isManual) this.globalFitMode = 'fitWidth';
    const bounds = this.calculateViewportBounds(), dims = this.queryNaturalDimensions(pNo);
    if (!bounds || !dims) return;
    this.pagePanMap[pNo] = { x: 0, y: 0 };
    this.pageFitModeMap[pNo] = 'fitWidth';
    this.updateZoom(pNo, Math.min(UI_CONFIG.ZOOM_MAX, Math.max(UI_CONFIG.ZOOM_MIN, (bounds.width / dims.width) * 100)), false);
  }

  setFitPage(pNo = this.activePageIndex, isManual = true) {
    if (isManual) this.globalFitMode = 'fitPage';
    const bounds = this.calculateViewportBounds(), dims = this.queryNaturalDimensions(pNo);
    if (!bounds || !dims) return;
    this.pagePanMap[pNo] = { x: 0, y: 0 };
    this.pageFitModeMap[pNo] = 'fitPage';
    this.updateZoom(pNo, Math.min(UI_CONFIG.ZOOM_MAX, Math.max(UI_CONFIG.ZOOM_MIN, Math.min(bounds.width / dims.width, bounds.height / dims.height) * 100)), false);
  }

  triggerAutoFit(pNo = this.activePageIndex) {
    if (this.globalFitMode === 'fitWidth') this.setFitWidth(pNo, false);
    else if (this.globalFitMode === 'fitPage') this.setFitPage(pNo, false);
    else if (this.pageFitModeMap[pNo] === 'fitWidth') this.setFitWidth(pNo, false);
    else this.setFitPage(pNo, false);
  }

  syncCanvasStyles(pNo) {
    if (pNo !== this.activePageIndex) return;
    const img = this.findNode('page_img'), annotCanvas = this.findNode('annot_canvas');
    if (!img) return;

    const zoom = this.pageZoomMap[pNo] || 100;
    const pan = this.pagePanMap[pNo] || { x: 0, y: 0 };
    const { targetDoc, targetPageNo } = PreviewCanvasController.mapPageTarget(this.currentDocument, pNo);
    const adj = this.resolveAdjustments(targetDoc?.rowKey, targetPageNo);

    const panX = Math.round(pan.x), panY = Math.round(pan.y);
    const trans = `translate(-50%,-50%) translate(${panX}px,${panY}px) scale(${zoom / 100}) rotate(${adj.rotation}deg)`;
    img.style.transform = trans;
    if (annotCanvas) annotCanvas.style.transform = trans;

    const isDef = adj.brightness === 100 && adj.contrast === 100 && adj.saturate === 100 && adj.sharpness === 0 && adj.grayscale === 0 && adj.invert === 0;
    img.style.filter = isDef ? 'none' : `brightness(${adj.brightness}%) contrast(${adj.contrast + adj.sharpness * 20}%) saturate(${adj.saturate}%) grayscale(${adj.grayscale}%) invert(${adj.invert}%)`;
  }

  executeWhitespaceTrim() {
    const img = this.findNode('page_img');
    if (!img?.naturalWidth) { this.displayToast('⚠️ 目前無可裁切影像'); return; }
    const trimmed = ByteInspector.computeWhitespaceCrop(img);
    if (!trimmed) { this.displayToast('ℹ️ 未偵測到明顯白邊'); return; }
    img.src = trimmed;
    img.onload = () => {
      this.pagePanMap[this.activePageIndex] = { x: 0, y: 0 };
      this.triggerAutoFit(this.activePageIndex);
      this.displayToast('✅ 已完成去白邊');
    };
  }

  refreshAdjustInputs() {
    if (!this.currentDocument) return;
    const { targetDoc, targetPageNo } = PreviewCanvasController.mapPageTarget(this.currentDocument, this.activePageIndex);
    const adj = this.resolveAdjustments(targetDoc?.rowKey, targetPageNo);

    ['brightness', 'contrast', 'saturate'].forEach(k => {
      const inp = this.findNode(k), lbl = this.findNode('val_' + k);
      if (inp) inp.value = String(adj[k]);
      if (lbl) lbl.textContent = adj[k] + '%';
    });
    const shInp = this.findNode('sharpness'), shLbl = this.findNode('val_sharpness');
    if (shInp) shInp.value = String(adj.sharpness);
    if (shLbl) shLbl.textContent = adj.sharpness > 0 ? ('+' + adj.sharpness) : '原圖';

    const gInp = this.findNode('grayscale'), invInp = this.findNode('invert');
    if (gInp) gInp.checked = adj.grayscale > 0;
    if (invInp) invInp.checked = adj.invert > 0;

    const sLbl = this.findNode('scope_indicator');
    if (sLbl) sLbl.textContent = `套用目標：已選 ${this.selectedPagesSet.size} / ${this.currentDocument.totalPages} 頁`;
  }

  renderPageTagGrid() {
    const grid = this.findNode('page_selector_grid');
    if (!grid || !this.currentDocument) return;
    grid.innerHTML = Array.from({ length: this.currentDocument.totalPages }, (_, i) => {
      const p = i + 1, active = this.selectedPagesSet.has(p);
      return `<label class="iw-page-tag ${active?'active':''}" style="font-size:11px;font-weight:700;"><input type="checkbox" data-target-page="${p}" ${active ? 'checked' : ''} style="accent-color:var(--iw-primary);margin-right:2px;">P.${p}</label>`;
    }).join('');

    grid.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
      cb.addEventListener('change', (e) => {
        const p = Number(e.target.dataset.targetPage);
        if (e.target.checked) this.selectedPagesSet.add(p); else this.selectedPagesSet.delete(p);
        cb.parentElement.classList.toggle('active', e.target.checked);
        this.refreshAdjustInputs();
      });
    });
  }

  renderShortcutLegend() {
    const sc = StorageCoordinator.resolveShortcuts();
    const node = this.findNode('shortcut_tip');
    if (node) node.textContent = `快捷鍵: ${ByteInspector.formatKeyBadge(sc.prevPage)}${ByteInspector.formatKeyBadge(sc.nextPage)} 翻頁 ｜ ${ByteInspector.formatKeyBadge(sc.rotateLeft)}${ByteInspector.formatKeyBadge(sc.rotateRight)} 旋轉 ｜ ${ByteInspector.formatKeyBadge(sc.fitPage)} 適頁 ｜ Ctrl+Z 復原`;
  }

  displayToast(msg) {
    const toast = this.findNode('preview_toast');
    if (!toast) return;
    toast.textContent = msg;
    toast.style.display = 'block';
    setTimeout(() => { toast.style.display = 'none'; }, 2800);
  }

  toggleSnipMode(forceState) {
    this.isSnipMode = forceState !== undefined ? forceState : !this.isSnipMode;
    const btnFull = this.findNode('btn_copy_full'), btnSnip = this.findNode('btn_copy_snip'), wrap = this.findNode('img_wrap');
    if (btnFull && btnSnip) {
      btnFull.classList.toggle('active', !this.isSnipMode);
      btnSnip.classList.toggle('active', this.isSnipMode);
    }
    if (wrap) wrap.style.cursor = this.isSnipMode ? 'crosshair' : (this.activeTool !== 'view' ? 'crosshair' : 'default');
    if (this.isSnipMode) this.displayToast('✂️ 請拖曳滑鼠框選目標區域（按 Esc 取消）');
  }

  setDrawingTool(toolName) {
    this.activeTool = (this.activeTool === toolName) ? 'view' : toolName;
    const wrap = this.findNode('img_wrap');
    if (wrap) wrap.style.cursor = (this.activeTool !== 'view' || this.isSnipMode) ? 'crosshair' : 'default';

    ['tool_rect', 'tool_pen', 'tool_text', 'tool_darken', 'tool_clear', 'tool_brighten'].forEach(id => this.findNode(id)?.classList.remove('active'));
    const map = { rect: 'tool_rect', pen: 'tool_pen', text: 'tool_text', local_darken: 'tool_darken', local_clear: 'tool_clear', local_brighten: 'tool_brighten' };
    this.findNode(map[this.activeTool])?.classList.add('active');

    if (this.activeTool !== 'view') {
      this.selectedAnnotation = null;
      this.redrawCurrentAnnotations();
      this.displayToast(`✏️ 已啟用：${{
        rect: '框線標註', pen: '畫筆標記', text: '點擊打字',
        local_darken: '字跡加深', local_clear: '清除灰底', local_brighten: '陰影提亮'
      }[this.activeTool] || '工具'}`);
    }
  }

  getCurrentPageKey() {
    if (!this.currentDocument) return '';
    const { targetDoc, targetPageNo } = PreviewCanvasController.mapPageTarget(this.currentDocument, this.activePageIndex);
    return this.formatAdjustKey(targetDoc?.rowKey || '', targetPageNo);
  }

  hitTestAnnotation(nativePt) {
    const pageKey = this.getCurrentPageKey();
    const anns = this.pageAnnotationsMap.get(pageKey) || [];
    const zoom = (this.pageZoomMap[this.activePageIndex] || 100) / 100;
    const handleRadius = 12 / zoom;

    if (this.selectedAnnotation && this.selectedAnnotation.type === 'rect' && this.selectedAnnotation.rect) {
      const r = this.selectedAnnotation.rect;
      const corners = [
        { handle: 'nw', x: r.x, y: r.y },
        { handle: 'ne', x: r.x + r.w, y: r.y },
        { handle: 'se', x: r.x + r.w, y: r.y + r.h },
        { handle: 'sw', x: r.x, y: r.y + r.h }
      ];
      for (const c of corners) {
        if (Math.hypot(nativePt.x - c.x, nativePt.y - c.y) <= handleRadius) {
          return { ann: this.selectedAnnotation, handle: c.handle };
        }
      }
    }

    for (let i = anns.length - 1; i >= 0; i--) {
      const ann = anns[i];
      if (ann.type === 'rect' && ann.rect) {
        const r = ann.rect;
        const tol = 8 / zoom;
        if (nativePt.x >= r.x - tol && nativePt.x <= r.x + r.w + tol &&
            nativePt.y >= r.y - tol && nativePt.y <= r.y + r.h + tol) {
          return { ann, handle: 'move' };
        }
      } else if (ann.type === 'text') {
        const tw = (ann.fontSize || 22) * (ann.text?.length || 1) * 0.85;
        const th = (ann.fontSize || 22) * 1.3;
        if (nativePt.x >= ann.x - 4 && nativePt.x <= ann.x + tw + 4 &&
            nativePt.y >= ann.y - 4 && nativePt.y <= ann.y + th + 4) {
          return { ann, handle: 'move' };
        }
      }
    }
    return null;
  }

  openInlineTextEditor(textAnn, clientX, clientY) {
    const oldInput = this.findNode('inline_text_input');
    if (oldInput) oldInput.remove();
    const wrapNode = this.findNode('img_wrap');
    if (!wrapNode) return;

    const wr = wrapNode.getBoundingClientRect();
    const inlineInp = document.createElement('input');
    inlineInp.id = MODAL_ID + '_inline_text_input';
    inlineInp.type = 'text';
    inlineInp.value = textAnn.text || '';
    Object.assign(inlineInp.style, {
      position: 'absolute',
      left: (clientX - wr.left) + 'px',
      top: (clientY - wr.top) + 'px',
      zIndex: '100',
      padding: '4px 8px',
      borderRadius: '4px',
      border: '2px solid var(--iw-primary)',
      background: 'var(--iw-bg-card)',
      color: textAnn.color || this.drawColor,
      fontSize: (textAnn.fontSize || this.fontSize) + 'px',
      fontWeight: '700',
      outline: 'none',
      boxShadow: '0 4px 14px rgba(0,0,0,0.3)'
    });

    const commitText = () => {
      const val = inlineInp.value.trim();
      if (val && val !== textAnn.text) {
        textAnn.text = val;
        this.redrawCurrentAnnotations();
        this.displayToast('✏️ 已更新標記文字');
      }
      inlineInp.remove();
      this.setDrawingTool('view');
    };

    inlineInp.addEventListener('keydown', (ke) => {
      if (ke.key === 'Enter') { ke.preventDefault(); commitText(); }
      else if (ke.key === 'Escape') { ke.preventDefault(); inlineInp.remove(); this.setDrawingTool('view'); }
    });
    inlineInp.addEventListener('blur', () => commitText());
    wrapNode.appendChild(inlineInp);
    setTimeout(() => { inlineInp.focus(); inlineInp.select(); }, 40);
  }

  deleteSelectedAnnotation() {
    if (!this.selectedAnnotation) {
      this.displayToast('ℹ️ 請先點選欲刪除的標記');
      return;
    }
    const pageKey = this.getCurrentPageKey();
    const list = this.pageAnnotationsMap.get(pageKey) || [];
    const idx = list.indexOf(this.selectedAnnotation);
    if (idx !== -1) {
      list.splice(idx, 1);
      this.selectedAnnotation = null;
      this.redrawCurrentAnnotations();
      this.displayToast('🗑️ 已刪除選定標記');
    }
  }

  redrawCurrentAnnotations() {
    const canvas = this.findNode('annot_canvas'), img = this.findNode('page_img');
    if (!canvas || !img?.naturalWidth) return;
    canvas.width = img.naturalWidth;
    canvas.height = img.naturalHeight;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const pageKey = this.getCurrentPageKey();
    const locs = this.pageLocalEnhanceMap.get(pageKey) || [];
    const anns = this.pageAnnotationsMap.get(pageKey) || [];
    if (locs.length) ctx.drawImage(img, 0, 0);
    RasterProcessingEngine.renderComposedLayers(ctx, canvas.width, canvas.height, anns, locs);

    if (this.selectedAnnotation) {
      ctx.save();
      ctx.strokeStyle = '#2563eb';
      ctx.lineWidth = 2;
      ctx.setLineDash([5, 4]);
      const ann = this.selectedAnnotation;
      if (ann.type === 'rect' && ann.rect) {
        const r = ann.rect;
        ctx.strokeRect(r.x - 2, r.y - 2, r.w + 4, r.h + 4);
        ctx.setLineDash([]);
        ctx.fillStyle = '#ffffff';
        ctx.strokeStyle = '#2563eb';
        const hs = 8;
        [[r.x, r.y], [r.x + r.w, r.y], [r.x + r.w, r.y + r.h], [r.x, r.y + r.h]].forEach(([cx, cy]) => {
          ctx.fillRect(cx - hs / 2, cy - hs / 2, hs, hs);
          ctx.strokeRect(cx - hs / 2, cy - hs / 2, hs, hs);
        });
      } else if (ann.type === 'text') {
        const tw = (ann.fontSize || 22) * (ann.text?.length || 1) * 0.85;
        const th = (ann.fontSize || 22) * 1.3;
        ctx.strokeRect(ann.x - 3, ann.y - 3, tw + 6, th + 6);
      }
      ctx.restore();
    }
  }

  undoLastAction() {
    const pageKey = this.getCurrentPageKey();
    const stack = this.pageActionStack.get(pageKey) || [];
    if (!stack.length) { this.displayToast('ℹ️ 無可復原的操作'); return; }
    const last = stack.pop();
    if (last.type === 'annotation') (this.pageAnnotationsMap.get(pageKey) || []).pop();
    else if (last.type === 'localEnhance') (this.pageLocalEnhanceMap.get(pageKey) || []).pop();
    this.selectedAnnotation = null;
    this.redrawCurrentAnnotations();
    this.displayToast('↩️ 已復原上一步操作');
  }

  clearCurrentAnnotations() {
    const pageKey = this.getCurrentPageKey();
    this.pageAnnotationsMap.delete(pageKey);
    this.pageLocalEnhanceMap.delete(pageKey);
    this.pageActionStack.delete(pageKey);
    this.selectedAnnotation = null;
    this.redrawCurrentAnnotations();
    this.displayToast('🗑️ 已清除標註與調優');
  }

  screenCoordToImageNative(clientX, clientY) {
    const img = this.findNode('page_img');
    if (!img?.naturalWidth || !img?.naturalHeight) return null;
    const { targetDoc, targetPageNo } = PreviewCanvasController.mapPageTarget(this.currentDocument, this.activePageIndex);
    const angle = this.resolveAdjustments(targetDoc?.rowKey, targetPageNo).rotation || 0;
    const rad = (-angle * Math.PI) / 180;
    const rect = img.getBoundingClientRect();
    const dx = clientX - (rect.left + rect.width / 2);
    const dy = clientY - (rect.top + rect.height / 2);
    const unrotX = dx * Math.cos(rad) - dy * Math.sin(rad);
    const unrotY = dx * Math.sin(rad) + dy * Math.cos(rad);
    const scale = (angle === 90 || angle === 270 ? rect.height : rect.width) / img.naturalWidth;
    return {
      x: ByteInspector.clampValue(img.naturalWidth / 2 + (unrotX / scale), 0, img.naturalWidth),
      y: ByteInspector.clampValue(img.naturalHeight / 2 + (unrotY / scale), 0, img.naturalHeight)
    };
  }

  promptTextInput(clientX, clientY, callback) {
    const oldPrompt = this.findNode('text_tool_input');
    if (oldPrompt) oldPrompt.remove();
    const wrap = this.findNode('img_wrap');
    if (!wrap) return;
    const wr = wrap.getBoundingClientRect();
    const box = document.createElement('div');
    box.id = MODAL_ID + '_text_tool_input';
    box.style.cssText = `position:absolute;left:${ByteInspector.clampValue(clientX - wr.left, 10, wr.width - 240)}px;top:${ByteInspector.clampValue(clientY - wr.top, 10, wr.height - 42)}px;z-index:100;display:flex;gap:4px;background:var(--iw-bg-card);padding:4px;border-radius:4px;border:1px solid var(--iw-primary);box-shadow:var(--iw-shadow-card);`;

    const inp = document.createElement('input');
    inp.type = 'text';
    inp.className = 'iw-input';
    inp.placeholder = '請輸入標記文字...';
    inp.style.cssText = 'height:26px;width:150px;font-size:12px;';

    const btnOk = document.createElement('button');
    btnOk.type = 'button';
    btnOk.className = 'iw-btn-primary';
    btnOk.style.cssText = 'height:26px;padding:0 8px;font-size:11px;';
    btnOk.textContent = '確定';

    const btnCancel = document.createElement('button');
    btnCancel.type = 'button';
    btnCancel.className = 'iw-btn-subtle';
    btnCancel.style.cssText = 'height:26px;padding:0 6px;font-size:11px;';
    btnCancel.textContent = '取消';

    const commit = () => {
      const val = inp.value;
      box.remove();
      callback(val);
      this.setDrawingTool('view');
    };

    const cancel = () => {
      box.remove();
      this.setDrawingTool('view');
      this.displayToast('已取消打字標註');
    };

    btnOk.onclick = commit;
    btnCancel.onclick = cancel;
    inp.onkeydown = (ke) => {
      ke.stopPropagation();
      if (ke.key === 'Enter') commit();
      if (ke.key === 'Escape') cancel();
    };

    box.appendChild(inp);
    box.appendChild(btnOk);
    box.appendChild(btnCancel);
    wrap.appendChild(box);
    requestAnimationFrame(() => inp.focus());
  }

  async executeSnipAndCopy(screenL, screenT, w, h) {
    try {
      this.displayToast('正在剪取高解析度圖檔...');
      const p1 = this.screenCoordToImageNative(screenL, screenT);
      const p2 = this.screenCoordToImageNative(screenL + w, screenT + h);
      if (!p1 || !p2) throw new Error('座標解析錯誤');

      const cropX = Math.min(p1.x, p2.x), cropY = Math.min(p1.y, p2.y);
      const cropW = Math.abs(p2.x - p1.x), cropH = Math.abs(p2.y - p1.y);
      if (cropW <= 2 || cropH <= 2) throw new Error('範圍過小');

      const rec = await this.ensurePageReady(this.activePageIndex);
      const { targetDoc, targetPageNo } = PreviewCanvasController.mapPageTarget(this.currentDocument, this.activePageIndex);
      const pageKey = this.getCurrentPageKey();
      const baked = await RasterProcessingEngine.transform(
        rec, this.resolveAdjustments(targetDoc?.rowKey, targetPageNo),
        this.pageAnnotationsMap.get(pageKey) || [], this.pageLocalEnhanceMap.get(pageKey) || []
      );

      const bUrl = URL.createObjectURL(new Blob([baked.data], { type: ByteInspector.extToMime(baked.ext) }));
      const fullImg = await new Promise((resolve, reject) => {
        const el = new Image(); el.onload = () => resolve(el); el.onerror = () => reject(new Error('載入失敗')); el.src = bUrl;
      }).finally(() => URL.revokeObjectURL(bUrl));

      const { canvas, ctx } = createCanvas(cropW, cropH);
      ctx.drawImage(fullImg, cropX, cropY, cropW, cropH, 0, 0, canvas.width, canvas.height);
      const blob = await canvasToBlob(canvas, 'image/png');

      if (!navigator.clipboard || !window.ClipboardItem) {
        ByteInspector.copyTextFallback(baked.name);
        this.displayToast('⚠️ 瀏覽器未支援圖檔寫入，已複製檔名');
        return;
      }
      await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
      this.displayToast('✅ 已將框選區域複製至剪貼簿！');
    } catch (err) {
      this.displayToast('❌ 剪取失敗:' + (err?.message || '未知錯誤'));
    }
  }

  async copyImageToClipboard() {
    try {
      this.displayToast('正在處理高畫質影像並複製...');
      const rec = await this.ensurePageReady(this.activePageIndex);
      if (rec.ext === '.pdf') throw new Error('PDF 格式不支援直接複製圖檔');
      const { targetDoc, targetPageNo } = PreviewCanvasController.mapPageTarget(this.currentDocument, this.activePageIndex);
      const pageKey = this.getCurrentPageKey();
      const rendered = await RasterProcessingEngine.transform(
        rec, this.resolveAdjustments(targetDoc?.rowKey, targetPageNo),
        this.pageAnnotationsMap.get(pageKey) || [], this.pageLocalEnhanceMap.get(pageKey) || []
      );
      const blob = new Blob([rendered.data], { type: 'image/png' });
      if (!navigator.clipboard || !window.ClipboardItem) {
        ByteInspector.copyTextFallback(rendered.name);
        this.displayToast('⚠️ 瀏覽器未支援圖檔寫入，已複製檔名');
        return;
      }
      await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
      this.displayToast('✅ 已成功複製圖片！');
    } catch (err) {
      this.displayToast('❌ 複製失敗:' + (err?.message || '環境限制'));
    }
  }

  generateHtml(doc) {
    const { targetDoc } = PreviewCanvasController.mapPageTarget(doc, this.activePageIndex);
    const initialDocId = targetDoc?.docId || doc.docId || '--';

    return `<section class="iw-main-viewport" aria-label="文件檢視工作台">
