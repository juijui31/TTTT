      const val = params.get('CLACCEPTNO') || params.get('RelatedAcceptNo') || params.get('indexValue') || params.get('CL_Serial') || params.get('CLSERIAL');
      if (val && val.trim()) return val.trim();
      for (const id of ['CLACCEPTNO', 'RelatedAcceptNo', 'CL_Serial', 'CLSERIAL', 'indexValue', 'caseNoInput']) {
        const node = document.getElementById(id);
        if (node) {
          const txt = node.value || node.textContent || node.innerText;
          if (txt && txt.trim()) return txt.trim();
