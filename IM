    const prefs = StorageCoordinator.read();
    if (Number.isFinite(prefs.ballLeft) && Number.isFinite(prefs.ballTop)) {
      ball.style.left = ByteInspector.clampValue(prefs.ballLeft, 10, window.innerWidth - UI_CONFIG.BALL_SIZE - 10) + 'px';
      ball.style.top = ByteInspector.clampValue(prefs.ballTop, 10, window.innerHeight - UI_CONFIG.BALL_SIZE - 10) + 'px';
