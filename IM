  async displayDocument(doc, targetPage = 1) {
    this.viewRenderId++;
    const curId = this.viewRenderId;
    this.disposeBlobUrls();
    this.currentDocument = doc;
    this.activePageIndex = ByteInspector.clampValue(Number.parseInt(targetPage, 10) || 1, 1, doc.totalPages);
    this.selectedPagesSet = new Set(Array.from({ length: doc.totalPages }, (_, i) => i + 1));
    this.pageZoomMap = {};
    this.pagePanMap = {};
    this.pageFitModeMap = {};
    this.currentMode = 'preview';
    this.selectedAnnotation = null;

    if (this.rightNode) {
      this.rightNode.style.display = 'flex';
      this.rightNode.innerHTML = this.generateHtml(doc);
    }
    if (this.onResizeLayout) this.onResizeLayout(true);

    this.wireEvents();
    this.setupHudDragging();
    this.restoreHudCoords();
    this.populateDocDropdown();
    this.renderPageTagGrid();
    this.refreshAdjustInputs();
    this.renderShortcutLegend();
    await this.renderPage(this.activePageIndex, curId);
  }

  wireEvents() {
    const $ = (id) => this.findNode(id);
    const tabPreview = $('tab_preview'), tabThumb = $('tab_thumb');
    const panelCanvas = $('canvas_root'), panelThumb = $('thumb_panel');

    const toggleTab = (mode) => {
      const isP = mode === 'preview';
      this.currentMode = mode;
      tabPreview?.classList.toggle('active', isP);
      tabThumb?.classList.toggle('active', !isP);
      if (panelCanvas) panelCanvas.hidden = !isP;
      if (panelThumb) panelThumb.hidden = isP;
      if (!isP) this.loadThumbnails();
    };
    tabPreview?.addEventListener('click', () => toggleTab('preview'));
    tabThumb?.addEventListener('click', () => toggleTab('thumb'));

    $('btn_copy_full')?.addEventListener('click', () => { this.toggleSnipMode(false); this.copyImageToClipboard(); });
    $('btn_copy_snip')?.addEventListener('click', () => this.toggleSnipMode(true));

    const popAdjust = $('filter_popover'), btnAdjust = $('filter_pop_toggle');
    const menuExport = $('export_menu'), btnExport = $('export_menu_toggle');

    // ISS-04 修復：連動 aria-expanded 屬性
    btnAdjust?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = !popAdjust.hidden;
      if (menuExport) {
        menuExport.hidden = true;
        btnExport?.setAttribute('aria-expanded', 'false');
      }
      popAdjust.hidden = open;
      btnAdjust.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    btnExport?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = !menuExport.hidden;
      if (popAdjust) {
        popAdjust.hidden = true;
        btnAdjust?.setAttribute('aria-expanded', 'false');
      }
      menuExport.hidden = open;
      btnExport.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    const onWinClick = (e) => {
      if (menuExport && !menuExport.hidden && !menuExport.contains(e.target) && e.target !== btnExport) {
        menuExport.hidden = true;
        btnExport?.setAttribute('aria-expanded', 'false');
      }
      if (popAdjust && !popAdjust.hidden) {
        const isCanvasClick = Boolean(e.target.closest('#' + MODAL_ID + '_canvas_root'));
        if (!popAdjust.contains(e.target) && e.target !== btnAdjust && !isCanvasClick) {
          popAdjust.hidden = true;
          btnAdjust?.setAttribute('aria-expanded', 'false');
        }
      }
    };
    if (this.globalClickDisposer) this.globalClickDisposer();
    document.addEventListener('click', onWinClick);
    this.globalClickDisposer = () => document.removeEventListener('click', onWinClick);

    const switchDrawerTab = (activeTab) => {
      ['full', 'local', 'annot'].forEach((t) => {
        $(`tab_adj_${t}`)?.classList.toggle('active', t === activeTab);
        const p = $(`panel_adj_${t}`);
        if (p) p.style.display = t === activeTab ? 'flex' : 'none';
      });
    };
    ['full', 'local', 'annot'].forEach(t => $(`tab_adj_${t}`)?.addEventListener('click', () => switchDrawerTab(t)));

    const toolMap = { tool_darken: 'local_darken', tool_clear: 'local_clear', tool_brighten: 'local_brighten', tool_rect: 'rect', tool_pen: 'pen', tool_text: 'text' };
    Object.entries(toolMap).forEach(([id, tName]) => $(id)?.addEventListener('click', () => this.setDrawingTool(tName)));

    const cp = $('color_picker');
    if (cp) cp.addEventListener('input', (e) => {
      this.drawColor = e.target.value;
      if (this.selectedAnnotation) {
        this.selectedAnnotation.color = this.drawColor;
        this.redrawCurrentAnnotations();
      }
    });
    document.querySelectorAll('.iw-palette-dot').forEach((dot) => {
      dot.addEventListener('click', () => {
        this.drawColor = dot.dataset.color || '#ef4444';
        if (cp) cp.value = this.drawColor;
        if (this.selectedAnnotation) {
          this.selectedAnnotation.color = this.drawColor;
          this.redrawCurrentAnnotations();
        }
      });
    });

    $('draw_size')?.addEventListener('input', (e) => {
      this.drawSize = Number(e.target.value);
      this.fontSize = Math.round(this.drawSize * 3.5 + 14);
      $('val_drawsize').textContent = e.target.value + 'px';
      if (this.selectedAnnotation) {
        if (this.selectedAnnotation.type === 'rect') this.selectedAnnotation.strokeWidth = this.drawSize;
        else if (this.selectedAnnotation.type === 'text') this.selectedAnnotation.fontSize = this.fontSize;
        this.redrawCurrentAnnotations();
      }
    });

    $('local_intensity')?.addEventListener('input', (e) => {
      this.localIntensity = Number(e.target.value);
      $('val_intensity').textContent = e.target.value + '%';
    });

    ['local', 'annot'].forEach((k) => {
      $(`btn_undo_${k}`)?.addEventListener('click', () => this.undoLastAction());
      $(`btn_clear_${k}`)?.addEventListener('click', () => this.clearCurrentAnnotations());
    });
    $('btn_del_selected')?.addEventListener('click', () => this.deleteSelectedAnnotation());

    $('pop_crop_white')?.addEventListener('click', () => this.executeWhitespaceTrim());
    $('exp_download_single')?.addEventListener('click', () => { if (menuExport) menuExport.hidden = true; this.downloadRenderedPage(); });
    $('exp_download_orig')?.addEventListener('click', () => { if (menuExport) menuExport.hidden = true; this.downloadOriginalPage(this.activePageIndex); });

    $('exp_print_doc')?.addEventListener('click', async () => {
      if (menuExport) menuExport.hidden = true;
      const doc = this.currentDocument;
      if (!doc) return;
      if (doc.isAllCase || doc.totalPages >= UI_CONFIG.LARGE_TASK_THRESHOLD) {
        const ok = await this.requestTaskConfirmation({
          type: 'print', scope: doc.formName, docCount: doc.isAllCase ? this.state.docGroupList.length : 1,
          totalPages: doc.totalPages, hasEdits: true
        });
        if (!ok) return;
      }
      const pw = window.open('', '_blank');
      if (pw) { pw.document.write('<!doctype html><html><body><h2>正在準備列印內容...</h2></body></html>'); pw.document.close(); }
      this.executeManagedTask('準備列印本文件', opts => this.printDocumentPages(Object.assign({}, opts, { printWin: pw })));
    });

    $('exp_zip_doc')?.addEventListener('click', async () => {
      if (menuExport) menuExport.hidden = true;
      const doc = this.currentDocument;
      if (!doc) return;
      if (doc.isAllCase || doc.totalPages >= UI_CONFIG.LARGE_TASK_THRESHOLD) {
        const ok = await this.requestTaskConfirmation({
          type: 'zip', scope: doc.formName, docCount: doc.isAllCase ? this.state.docGroupList.length : 1,
          totalPages: doc.totalPages, hasEdits: false
        });
        if (!ok) return;
      }
      this.executeManagedTask('建立 ZIP 打包', opts => this.zipDocumentPages(opts));
    });

    $('close_preview')?.addEventListener('click', () => this.closeViewport());
    $('toggle_hud_orient')?.addEventListener('click', () => {
      const hud = $('floating_hud');
      if (!hud) return;
      this.hudLayout = this.hudLayout === 'horizontal' ? 'vertical' : 'horizontal';
      hud.className = 'iw-floating-hud ' + this.hudLayout;
      StorageCoordinator.write({ hudOrientation: this.hudLayout });
      this.alignHudBoundary();
    });

    ['brightness', 'contrast', 'saturate'].forEach(k => {
      $(k)?.addEventListener('input', (e) => {
        $(`val_${k}`).textContent = e.target.value + '%';
        this.applyBatchAdjustments({ [k]: Number(e.target.value) });
      });
    });

    $('sharpness')?.addEventListener('input', (e) => {
      const v = Number(e.target.value);
      $('val_sharpness').textContent = v > 0 ? ('+' + v) : '原圖';
      this.applyBatchAdjustments({ sharpness: v });
    });

    $('grayscale')?.addEventListener('change', e => this.applyBatchAdjustments({ grayscale: e.target.checked ? 100 : 0 }));
    $('invert')?.addEventListener('change', e => this.applyBatchAdjustments({ invert: e.target.checked ? 100 : 0 }));
    $('filter_reset')?.addEventListener('click', () => this.applyBatchAdjustments({ brightness: 100, contrast: 100, saturate: 100, sharpness: 0, grayscale: 0, invert: 0 }));

    const jumpActions = {
      jump_first: () => 1,
      jump_last: () => this.currentDocument?.totalPages || 1,
      jump_prev: () => Math.max(1, this.activePageIndex - 1),
      jump_next: () => Math.min(this.currentDocument?.totalPages || 1, this.activePageIndex + 1)
    };
    Object.entries(jumpActions).forEach(([id, fn]) => $(id)?.addEventListener('click', () => this.renderPage(fn())));

    $('fit_page')?.addEventListener('click', () => this.setFitPage());
    $('fit_width')?.addEventListener('click', () => this.setFitWidth());
    $('zoom_out')?.addEventListener('click', () => this.stepZoom(-25));
    $('zoom_in')?.addEventListener('click', () => this.stepZoom(25));
    $('rotate_left')?.addEventListener('click', () => this.modifyRotation(this.activePageIndex, -90));
    $('rotate_right')?.addEventListener('click', () => this.modifyRotation(this.activePageIndex, 90));
    $('rotate_all_left')?.addEventListener('click', () => { for (const p of this.selectedPagesSet) this.modifyRotation(p, -90); });
    $('rotate_all_right')?.addEventListener('click', () => { for (const p of this.selectedPagesSet) this.modifyRotation(p, 90); });

    const inputJump = $('jump_input');
    if (inputJump) inputJump.addEventListener('change', () => this.renderPage(Number(inputJump.value)));
  }

  requestTaskConfirmation(taskData) {
    return new Promise((resolve) => {
      this.confirmResolver = resolve;
      const dlg = this.findNode('confirm_dialog'), details = this.findNode('confirm_details');
      const btnCancel = this.findNode('confirm_cancel'), btnProceed = this.findNode('confirm_proceed');
      if (!dlg || !details || !btnCancel || !btnProceed) return resolve(true);

      details.innerHTML = `<div>• 範圍：<b style="color:var(--iw-text-main);">${ByteInspector.escapeXml(taskData.scope)}</b></div><div>• 文件數量：${taskData.docCount} 份 (${taskData.totalPages} 頁)</div><div>• 輸出：${taskData.type === 'print' ? '🖨️ 列印(PDF)' : '📦 ZIP 打包'}</div>`;
      const teardown = (choice) => {
        this.confirmResolver = null;
        dlg.style.display = 'none';
        btnCancel.onclick = null;
        btnProceed.onclick = null;
        resolve(choice);
      };
      btnCancel.onclick = () => teardown(false);
      btnProceed.onclick = () => teardown(true);
      dlg.style.display = 'flex';
    });
  }

  async executeManagedTask(initMessage, executor) {
    const statusTrack = this.findNode('doc_task_status'), messageNode = this.findNode('doc_task_msg');
    const progressBar = this.findNode('doc_task_progress'), btnCancel = this.findNode('doc_task_cancel');
    if (!statusTrack || !messageNode || !progressBar) return;

    if (this.taskAbortCtrl) this.taskAbortCtrl.abort();
    const ctrl = new AbortController();
    this.taskAbortCtrl = ctrl;

    statusTrack.style.display = 'flex';
    messageNode.textContent = initMessage;
    progressBar.value = 0;
    if (btnCancel) { btnCancel.disabled = false; btnCancel.removeAttribute('aria-disabled'); }

    const onCancel = () => {
      if (btnCancel) btnCancel.disabled = true;
      messageNode.textContent = '正在取消作業…';
      ctrl.abort();
    };
    btnCancel?.addEventListener('click', onCancel, { once: true });

    try {
      await executor({
        signal: ctrl.signal,
        onProgress: (prog) => {
          const pct = Math.round((prog.current / prog.total) * 100);
          progressBar.value = pct;
          messageNode.textContent = `${prog.label || '處理中'}：第 ${prog.current}/${prog.total} 頁 (${pct}%)`;
        }
      });
      messageNode.textContent = '處理完成';
      progressBar.value = 100;
    } catch (_) {
      messageNode.textContent = ctrl.signal.aborted ? '已取消作業' : '處理失敗，請檢查網路';
    } finally {
      btnCancel?.removeEventListener('click', onCancel);
      setTimeout(() => { if (this.taskAbortCtrl === ctrl) { statusTrack.style.display = 'none'; this.taskAbortCtrl = null; } }, 3500);
    }
  }

  restoreHudCoords() {
    const hud = this.findNode('floating_hud');
    if (!hud || !this.hudCoords) return;
    hud.style.bottom = 'auto';
    hud.style.transform = 'none';
    hud.style.left = this.hudCoords.left + 'px';
    hud.style.top = this.hudCoords.top + 'px';
    requestAnimationFrame(() => this.alignHudBoundary());
  }

  setupHudDragging() {
    if (this.hudDragDisposer) this.hudDragDisposer();
    const hud = this.findNode('floating_hud'), handle = this.findNode('hud_drag_handle'), canvas = this.findNode('canvas_root');
    if (!hud || !handle || !canvas) return;

    let initL = 0, initT = 0;
    this.hudDragDisposer = bindDraggable({
      handle,
      onStart: () => {
        const hudR = hud.getBoundingClientRect(), cvR = canvas.getBoundingClientRect();
        initL = hudR.left - cvR.left;
        initT = hudR.top - cvR.top;
        hud.style.bottom = 'auto';
        hud.style.transform = 'none';
        hud.style.left = initL + 'px';
        hud.style.top = initT + 'px';
      },
      onMove: (dx, dy) => {
        const cvR = canvas.getBoundingClientRect(), hudR = hud.getBoundingClientRect();
        const nL = ByteInspector.clampValue(initL + dx, 0, Math.max(0, cvR.width - hudR.width));
        const nT = ByteInspector.clampValue(initT + dy, 0, Math.max(0, cvR.height - hudR.height));
        hud.style.left = nL + 'px';
        hud.style.top = nT + 'px';
        this.hudCoords = { left: nL, top: nT };
      },
      onEnd: () => {
        const cvR = canvas.getBoundingClientRect(), hudR = hud.getBoundingClientRect();
        const snap = UI_CONFIG.SNAP_DISTANCE, pad = 14;
        let fL = hud.offsetLeft, fT = hud.offsetTop;
        const maxL = Math.max(0, cvR.width - hudR.width), maxT = Math.max(0, cvR.height - hudR.height);
        if (fL <= snap) fL = pad; else if (fL >= maxL - snap) fL = maxL - pad;
        if (fT <= snap) fT = pad; else if (fT >= maxT - snap) fT = maxT - pad;
        const cX = (cvR.width - hudR.width) / 2;
        if (Math.abs(fL - cX) <= snap && fT >= maxT - snap) fL = cX;
        fL = ByteInspector.clampValue(fL, 0, maxL);
        fT = ByteInspector.clampValue(fT, 0, maxT);
        hud.style.transition = 'left 0.15s ease,top 0.15s ease';
        hud.style.left = fL + 'px';
        hud.style.top = fT + 'px';
        setTimeout(() => { hud.style.transition = ''; }, 200);
        this.hudCoords = { left: fL, top: fT };
        StorageCoordinator.write({ hudLeft: fL, hudTop: fT });
      }
    });
  }

  alignHudBoundary() {
    const hud = this.findNode('floating_hud'), canvas = this.findNode('canvas_root');
    if (!hud || !canvas || hud.style.bottom !== 'auto') return;
    const cvR = canvas.getBoundingClientRect(), hudR = hud.getBoundingClientRect();
    const bL = ByteInspector.clampValue(hud.offsetLeft, 0, Math.max(0, cvR.width - hudR.width));
    const bT = ByteInspector.clampValue(hud.offsetTop, 0, Math.max(0, cvR.height - hudR.height));
    hud.style.left = bL + 'px';
    hud.style.top = bT + 'px';
    this.hudCoords = { left: bL, top: bT };
  }

  loadThumbnails() {
    const grid = this.findNode('thumb_grid');
    if (!grid || !this.currentDocument) return;
    grid.innerHTML = Array.from({ length: this.currentDocument.totalPages }, (_, i) => {
      const p = i + 1;
      const { targetDoc, targetPageNo } = PreviewCanvasController.mapPageTarget(this.currentDocument, p);
      const title = this.currentDocument.isAllCase ? `[${targetDoc?.formId || '--'}] P.${targetPageNo}` : `第 ${p} 頁`;
      return `<div class="iw-thumb-card ${p===this.activePageIndex?'selected':''}" data-page="${p}" role="button" tabindex="0">
        <div id="${MODAL_ID}_thumb_box_${p}" style="height:130px;background:var(--iw-bg-surface);border-radius:6px;display:flex;align-items:center;justify-content:center;overflow:hidden;color:var(--iw-text-muted);font-size:11px;border:1px solid var(--iw-border-subtle);font-weight:700;">載入中...</div>
        <div style="font-size:11px;font-weight:700;color:var(--iw-text-main);text-align:center;margin-top:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${ByteInspector.escapeXml(title)}</div>
      </div>`;
    }).join('');

    grid.querySelectorAll('.iw-thumb-card').forEach((card) => {
      const p = Number(card.dataset.page);
      const box = card.querySelector('#' + MODAL_ID + '_thumb_box_' + p);
      this.ensurePageReady(p).then(data => this.drawThumbnailBox(box, data, p)).catch(() => { if (box) box.textContent = '讀取失敗'; });
      const select = () => { this.findNode('tab_preview')?.click(); this.renderPage(p); };
      card.addEventListener('click', select);
      card.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(); } });
    });
  }

  drawThumbnailBox(boxNode, fileRecord, pageNumber) {
    if (!boxNode || !fileRecord || !this.currentDocument) return;
    if (fileRecord.ext === '.pdf') { boxNode.innerHTML = '<strong style="color:var(--iw-text-main);font-size:13px;">PDF</strong>'; return; }
    let url = this.thumbnailUrlRegistry.get(pageNumber);
    if (!url && fileRecord.data) {
      url = URL.createObjectURL(new Blob([fileRecord.data], { type: ByteInspector.extToMime(fileRecord.ext) }));
      this.thumbnailUrlRegistry.set(pageNumber, url);
    }
    if (url) {
      const { targetDoc, targetPageNo } = PreviewCanvasController.mapPageTarget(this.currentDocument, pageNumber);
      const adj = this.resolveAdjustments(targetDoc?.rowKey, targetPageNo);
      boxNode.innerHTML = `<img src="${url}" style="max-width:100%;max-height:100%;object-fit:contain;transform:rotate(${adj.rotation}deg);filter:brightness(${adj.brightness}%)contrast(${adj.contrast+adj.sharpness*20}%)saturate(${adj.saturate}%)grayscale(${adj.grayscale}%)invert(${adj.invert}%);image-rendering:auto;">`;
    }
  }

  populateDocDropdown() {
    const select = this.findNode('doc_select');
    if (!select) return;
    const allTotal = this.state.docGroupList.reduce((sum, item) => sum + item.totalPages, 0);
    const options = [];
    if (this.state.docGroupList.length > 1) {
      options.push(`<option value="__ALL__" ${this.currentDocument?.isAllCase ? 'selected' : ''}>[全部] 本案所有文件總覽 (${allTotal} 頁)</option>`);
    }
    this.state.docGroupList.forEach((d) => {
      const isSel = !this.currentDocument?.isAllCase && String(d.rowKey) === String(this.currentDocument?.rowKey);
      options.push(`<option value="${ByteInspector.escapeXml(d.rowKey)}" ${isSel ? 'selected' : ''}>[${ByteInspector.escapeXml(d.formId)}] ${ByteInspector.escapeXml(d.formName)} (${d.totalPages} 頁)</option>`);
    });
    select.innerHTML = options.join('');
    select.onchange = (e) => {
      if (e.target.value === '__ALL__') this.onSelectDoc?.(ByteInspector.buildVirtualAllCaseDocument(this.state.docGroupList), 1);
      else {
        const hit = this.state.docGroupList.find(d => String(d.rowKey) === String(e.target.value));
        if (hit) this.onSelectDoc?.(hit, 1);
      }
    };
  }

  async ensurePageReady(pageNumber) {
    const pNo = ByteInspector.clampValue(Number(pageNumber) || 1, 1, this.currentDocument.totalPages);
    const { targetDoc, targetPageNo } = PreviewCanvasController.mapPageTarget(this.currentDocument, pNo);
    if (!targetDoc) throw new Error('目標文件不存在');
    const item = {
      cacheNamespace: this.state.currentCaseNoRaw, docId: targetDoc.docId, currentPage: targetPageNo,
      totalPage: targetDoc.totalPages, mimeType: targetDoc.mimeType, formName: targetDoc.formName,
      rawName: `${this.state.currentCaseNoSafe}_${ByteInspector.truncateText(targetDoc.formId, 40)}_p${targetPageNo}`
    };
    return await this.fetcher.acquireSingleImage(item, { useCache: true, purpose: 'preview' });
  }

  async renderPage(pageNumber, renderToken = this.viewRenderId) {
    if (!this.currentDocument) return;
    if (this.canvasInteractDisposer) { this.canvasInteractDisposer(); this.canvasInteractDisposer = null; }

    const targetNum = ByteInspector.clampValue(Number.parseInt(pageNumber, 10) || 1, 1, this.currentDocument.totalPages);
    this.activePageIndex = targetNum;

    const inp = this.findNode('jump_input');
    if (inp) inp.value = String(targetNum);

    const { targetDoc, targetPageNo } = PreviewCanvasController.mapPageTarget(this.currentDocument, targetNum);
    const curDocId = targetDoc?.docId || '--';
    const badge = this.findNode('top_docid_badge');
    if (badge) badge.textContent = 'DocID:' + curDocId;

    const bc = this.findNode('canvas_breadcrumb');
    if (bc) {
      bc.style.display = 'block';
      bc.innerHTML = this.currentDocument.isAllCase
        ? `當前：<b style="color:var(--iw-text-main)">[${ByteInspector.escapeXml(targetDoc?.formId || '--')}] ${ByteInspector.escapeXml(targetDoc?.formName || '文件')}</b> ｜ <span style="color:var(--iw-primary);font-weight:700;">DocID: ${ByteInspector.escapeXml(curDocId)}</span> (第 ${targetPageNo}/${targetDoc?.totalPages || 1} 頁) · 全案第 ${targetNum}/${this.currentDocument.totalPages} 頁`
        : `當前文件：<b style="color:var(--iw-text-main)">[${ByteInspector.escapeXml(this.currentDocument.formId)}] ${ByteInspector.escapeXml(this.currentDocument.formName)}</b> ｜ <span style="color:var(--iw-primary);font-weight:700;">DocID: ${ByteInspector.escapeXml(curDocId)}</span> (第 ${targetNum}/${this.currentDocument.totalPages} 頁)`;
    }

    const wrap = this.findNode('img_wrap');
    if (wrap) wrap.innerHTML = `<div style="color:var(--iw-primary);font-weight:700;display:flex;align-items:center;justify-content:center;height:100%;">載入第 ${targetNum} 頁...</div>`;

    try {
      const rec = await this.ensurePageReady(targetNum);
      if (renderToken !== this.viewRenderId || targetNum !== this.activePageIndex || !this.currentDocument) return;
      this.attachImageToDom(targetNum, rec);
    } catch (err) {
      if (RemoteDataFetcher.isAbort(err) && err.name !== 'TimeoutError') return;
      if (renderToken === this.viewRenderId && wrap && targetNum === this.activePageIndex) {
        wrap.innerHTML = `<div style="text-align:center;color:var(--iw-danger);display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:20px;"><div style="font-size:24px;margin-bottom:10px;">⚠️</div><div style="font-size:14px;font-weight:bold;margin-bottom:6px;">第 ${targetNum} 頁載入失敗</div><button id="${MODAL_ID}_retry_page" class="iw-btn-subtle" style="margin-top:12px;" type="button">重新載入</button></div>`;
        this.findNode('retry_page')?.addEventListener('click', () => this.renderPage(targetNum));
      }
    }
  }

  attachImageToDom(pageNumber, record) {
    const wrap = this.findNode('img_wrap');
    if (!wrap) return;

    if (this.currentPreviewBlobUrl) {
      try { URL.revokeObjectURL(this.currentPreviewBlobUrl); } catch (_) {}
    }
    const url = URL.createObjectURL(new Blob([record.data], { type: ByteInspector.extToMime(record.ext) }));
    this.currentPreviewBlobUrl = url;

    if (record.ext === '.pdf') {
      wrap.innerHTML = `<embed src="${url}" type="application/pdf" style="width:100%;height:100%;border:none;">`;
      return;
    }

    const img = document.createElement('img');
    img.id = MODAL_ID + '_page_img';
    img.src = url;
    img.draggable = false;
    img.style.cssText = 'position:absolute;left:50%;top:50%;width:auto;height:auto;max-width:none;max-height:none;border-radius:4px;border:1px solid var(--iw-border-subtle);transform-origin:center center;user-select:none;cursor:grab;box-shadow:var(--iw-shadow-sm);image-rendering:-webkit-optimize-contrast;image-rendering:auto;';

    const annotCanvas = document.createElement('canvas');
    annotCanvas.id = MODAL_ID + '_annot_canvas';
    annotCanvas.style.cssText = 'position:absolute;left:50%;top:50%;pointer-events:none;transform-origin:center center;user-select:none;z-index:20;';

    const marquee = document.createElement('div');
    marquee.id = MODAL_ID + '_marquee_box';
    marquee.className = 'iw-marquee-box';
    marquee.style.display = 'none';

    wrap.innerHTML = '';
    wrap.appendChild(img);
    wrap.appendChild(annotCanvas);
    wrap.appendChild(marquee);

    this.pageZoomMap[pageNumber] = this.pageZoomMap[pageNumber] || 100;
    this.pagePanMap[pageNumber] = this.pagePanMap[pageNumber] || { x: 0, y: 0 };
    this.pageFitModeMap[pageNumber] = this.pageFitModeMap[pageNumber] || this.globalFitMode || 'fitPage';
    this.setupCanvasPanZoom(pageNumber, img, wrap, marquee);

    img.addEventListener('load', () => {
      this.redrawCurrentAnnotations();
      this.syncCanvasStyles(pageNumber);
      requestAnimationFrame(() => this.triggerAutoFit(pageNumber));
    }, { once: true });
  }

  setupCanvasPanZoom(pNo, imgNode, wrapNode, marqueeNode) {
    if (this.canvasInteractDisposer) this.canvasInteractDisposer();
    let isPanning = false, isMarqueeZoom = false, isSnipping = false, isDrawing = false;
    let ox = 0, oy = 0, ix = 0, iy = 0, sx = 0, sy = 0;
    let drawNativeStart = null, currentPath = [], renderFrame = null;

    const onWheel = (e) => {
      e.preventDefault();
      if (e.ctrlKey) {
        this.updateZoom(pNo, (this.pageZoomMap[pNo] || 100) + (e.deltaY < 0 ? 20 : -20), true);
      } else {
        const now = Date.now();
        if (now - this.wheelThrottleTimer < 240) return;
        if (Math.abs(e.deltaY) >= 30) {
          this.wheelThrottleTimer = now;
          if (e.deltaY > 0) { if (this.activePageIndex < this.currentDocument.totalPages) this.renderPage(this.activePageIndex + 1); }
          else { if (this.activePageIndex > 1) this.renderPage(this.activePageIndex - 1); }
        }
      }
    };

    const onMouseDown = (e) => {
      if (this.isSnipMode && e.button === 0) {
        isSnipping = true;
        const wr = wrapNode.getBoundingClientRect();
        sx = e.clientX - wr.left; sy = e.clientY - wr.top;
        marqueeNode.style.borderColor = 'var(--iw-primary)';
        marqueeNode.style.background = 'var(--iw-primary-light)';
        marqueeNode.style.left = sx + 'px'; marqueeNode.style.top = sy + 'px';
        marqueeNode.style.width = '0px'; marqueeNode.style.height = '0px';
        marqueeNode.style.display = 'block';
        return;
      }
      if (this.activeTool !== 'view' && e.button === 0) {
        const nPt = this.screenCoordToImageNative(e.clientX, e.clientY);
        if (!nPt) return;
        if (this.activeTool === 'text') {
          this.promptTextInput(e.clientX, e.clientY, (val) => {
            if (val?.trim()) {
              const pk = this.getCurrentPageKey();
              const list = this.pageAnnotationsMap.get(pk) || [], st = this.pageActionStack.get(pk) || [];
              const item = { type: 'text', text: val.trim(), x: nPt.x, y: nPt.y, color: this.drawColor, fontSize: this.fontSize };
              list.push(item); st.push({ type: 'annotation', item });
              this.pageAnnotationsMap.set(pk, list); this.pageActionStack.set(pk, st);
              this.redrawCurrentAnnotations();
            }
          });
          return;
        }
        isDrawing = true;
        drawNativeStart = nPt;
        const wr = wrapNode.getBoundingClientRect();
        sx = e.clientX - wr.left; sy = e.clientY - wr.top;
        if (this.activeTool === 'pen') currentPath = [nPt];
        else {
          marqueeNode.style.borderColor = this.activeTool.startsWith('local_') ? 'var(--iw-success)' : this.drawColor;
          marqueeNode.style.background = this.activeTool.startsWith('local_') ? 'rgba(16,185,129,0.15)' : 'rgba(239,68,68,0.12)';
          marqueeNode.style.left = sx + 'px'; marqueeNode.style.top = sy + 'px';
          marqueeNode.style.width = '0px'; marqueeNode.style.height = '0px';
          marqueeNode.style.display = 'block';
        }
        return;
      }
      if (e.button === 0) {
        const nPt = this.screenCoordToImageNative(e.clientX, e.clientY);
        if (nPt) {
          const hit = this.hitTestAnnotation(nPt);
          if (hit) {
            this.selectedAnnotation = hit.ann;
            this.dragHandle = hit.handle;
            this.dragStartNative = nPt;
            this.dragStartAnnSnapshot = JSON.parse(JSON.stringify(hit.ann));
            this.redrawCurrentAnnotations();
            return;
          }
        }
        if (this.selectedAnnotation) {
          this.selectedAnnotation = null;
          this.redrawCurrentAnnotations();
        }
        isPanning = true; ox = e.clientX; oy = e.clientY;
        const cur = this.pagePanMap[pNo] || { x: 0, y: 0 };
        ix = cur.x; iy = cur.y;
        imgNode.style.cursor = 'grabbing';
      } else if (e.button === 2) {
        isMarqueeZoom = true;
        const wr = wrapNode.getBoundingClientRect();
        sx = e.clientX - wr.left; sy = e.clientY - wr.top;
        marqueeNode.style.borderColor = 'var(--iw-primary)';
        marqueeNode.style.background = 'var(--iw-primary-light)';
        marqueeNode.style.left = sx + 'px'; marqueeNode.style.top = sy + 'px';
        marqueeNode.style.width = '0px'; marqueeNode.style.height = '0px';
        marqueeNode.style.display = 'block';
      }
    };

    const onMouseMove = (e) => {
      if (this.dragHandle && this.selectedAnnotation) {
        const nPt = this.screenCoordToImageNative(e.clientX, e.clientY);
        if (!nPt || !this.dragStartNative || !this.dragStartAnnSnapshot) return;
        const dx = nPt.x - this.dragStartNative.x;
        const dy = nPt.y - this.dragStartNative.y;
        const snap = this.dragStartAnnSnapshot;

        if (this.selectedAnnotation.type === 'rect' && snap.rect) {
          const r = this.selectedAnnotation.rect;
          if (this.dragHandle === 'move') {
            r.x = Math.round(snap.rect.x + dx);
            r.y = Math.round(snap.rect.y + dy);
          } else if (this.dragHandle === 'se') {
            r.w = Math.max(10, Math.round(snap.rect.w + dx));
            r.h = Math.max(10, Math.round(snap.rect.h + dy));
          } else if (this.dragHandle === 'nw') {
            r.x = Math.round(snap.rect.x + dx);
            r.y = Math.round(snap.rect.y + dy);
            r.w = Math.max(10, Math.round(snap.rect.w - dx));
            r.h = Math.max(10, Math.round(snap.rect.h - dy));
          } else if (this.dragHandle === 'ne') {
            r.y = Math.round(snap.rect.y + dy);
            r.w = Math.max(10, Math.round(snap.rect.w + dx));
            r.h = Math.max(10, Math.round(snap.rect.h - dy));
          } else if (this.dragHandle === 'sw') {
            r.x = Math.round(snap.rect.x + dx);
            r.w = Math.max(10, Math.round(snap.rect.w - dx));
            r.h = Math.max(10, Math.round(snap.rect.h + dy));
          }
        } else if (this.selectedAnnotation.type === 'text') {
          this.selectedAnnotation.x = Math.round(snap.x + dx);
          this.selectedAnnotation.y = Math.round(snap.y + dy);
        }
        this.redrawCurrentAnnotations();
        return;
      }
      if (isSnipping) {
        const wr = wrapNode.getBoundingClientRect();
        const cx = ByteInspector.clampValue(e.clientX - wr.left, 0, wr.width), cy = ByteInspector.clampValue(e.clientY - wr.top, 0, wr.height);
        marqueeNode.style.left = Math.min(sx, cx) + 'px'; marqueeNode.style.top = Math.min(sy, cy) + 'px';
        marqueeNode.style.width = Math.abs(cx - sx) + 'px'; marqueeNode.style.height = Math.abs(cy - sy) + 'px';
        return;
      }
      if (isDrawing) {
        if (this.activeTool === 'pen') {
          const pt = this.screenCoordToImageNative(e.clientX, e.clientY);
          if (pt) {
            currentPath.push(pt);
            const cv = this.findNode('annot_canvas'), ctx = cv?.getContext('2d');
            if (ctx && currentPath.length > 1) {
              ctx.strokeStyle = this.drawColor; ctx.lineWidth = this.drawSize; ctx.lineCap = 'round';
              ctx.beginPath();
              ctx.moveTo(currentPath[currentPath.length - 2].x, currentPath[currentPath.length - 2].y);
              ctx.lineTo(pt.x, pt.y);
              ctx.stroke();
            }
          }
        } else {
          const wr = wrapNode.getBoundingClientRect();
          const cx = ByteInspector.clampValue(e.clientX - wr.left, 0, wr.width), cy = ByteInspector.clampValue(e.clientY - wr.top, 0, wr.height);
          marqueeNode.style.left = Math.min(sx, cx) + 'px'; marqueeNode.style.top = Math.min(sy, cy) + 'px';
          marqueeNode.style.width = Math.abs(cx - sx) + 'px'; marqueeNode.style.height = Math.abs(cy - sy) + 'px';
        }
        return;
      }
      if (isPanning) {
        const nx = ix + e.clientX - ox, ny = iy + e.clientY - oy;
        if (!renderFrame) {
          renderFrame = requestAnimationFrame(() => {
            this.pagePanMap[pNo] = { x: nx, y: ny };
            this.pageFitModeMap[pNo] = null;
            this.syncCanvasStyles(pNo);
            renderFrame = null;
          });
        }
      } else if (isMarqueeZoom) {
        const wr = wrapNode.getBoundingClientRect();
        const cx = ByteInspector.clampValue(e.clientX - wr.left, 0, wr.width), cy = ByteInspector.clampValue(e.clientY - wr.top, 0, wr.height);
        marqueeNode.style.left = Math.min(sx, cx) + 'px'; marqueeNode.style.top = Math.min(sy, cy) + 'px';
        marqueeNode.style.width = Math.abs(cx - sx) + 'px'; marqueeNode.style.height = Math.abs(cy - sy) + 'px';
      }
    };

    const onMouseUp = async (e) => {
      if (this.dragHandle) {
        this.dragHandle = null;
        this.dragStartNative = null;
        this.dragStartAnnSnapshot = null;
        return;
      }
      if (isSnipping && e.button === 0) {
        isSnipping = false;
        marqueeNode.style.display = 'none';
        const wr = wrapNode.getBoundingClientRect();
        const endX = ByteInspector.clampValue(e.clientX - wr.left, 0, wr.width), endY = ByteInspector.clampValue(e.clientY - wr.top, 0, wr.height);
        const w = Math.abs(endX - sx), h = Math.abs(endY - sy);
        this.toggleSnipMode(false);
        if (w > 8 && h > 8) await this.executeSnipAndCopy(wr.left + Math.min(sx, endX), wr.top + Math.min(sy, endY), w, h);
        return;
      }
      if (isDrawing && e.button === 0) {
        isDrawing = false;
        marqueeNode.style.display = 'none';
        const pk = this.getCurrentPageKey(), st = this.pageActionStack.get(pk) || [];
        if (this.activeTool === 'pen') {
          if (currentPath.length > 1) {
            const list = this.pageAnnotationsMap.get(pk) || [];
            const it = { type: 'pen', points: currentPath, color: this.drawColor, strokeWidth: this.drawSize };
            list.push(it); st.push({ type: 'annotation', item: it });
            this.pageAnnotationsMap.set(pk, list); this.pageActionStack.set(pk, st);
          }
          currentPath = [];
          this.setDrawingTool('view');
        } else if (this.activeTool === 'rect' || this.activeTool.startsWith('local_')) {
          const ptEnd = this.screenCoordToImageNative(e.clientX, e.clientY);
          if (drawNativeStart && ptEnd) {
            const rx = Math.min(drawNativeStart.x, ptEnd.x), ry = Math.min(drawNativeStart.y, ptEnd.y);
            const rw = Math.abs(ptEnd.x - drawNativeStart.x), rh = Math.abs(ptEnd.y - drawNativeStart.y);
            if (rw > 5 && rh > 5) {
              if (this.activeTool === 'rect') {
                const list = this.pageAnnotationsMap.get(pk) || [];
                const it = { type: 'rect', rect: { x: rx, y: ry, w: rw, h: rh }, color: this.drawColor, strokeWidth: this.drawSize };
                list.push(it); st.push({ type: 'annotation', item: it });
                this.pageAnnotationsMap.set(pk, list);
                this.selectedAnnotation = it;
              } else {
                const list = this.pageLocalEnhanceMap.get(pk) || [];
                const it = { rect: { x: rx, y: ry, w: rw, h: rh }, mode: this.activeTool.replace('local_', ''), intensity: this.localIntensity };
                list.push(it); st.push({ type: 'localEnhance', item: it });
                this.pageLocalEnhanceMap.set(pk, list);
              }
              this.pageActionStack.set(pk, st);
              this.redrawCurrentAnnotations();
            }
          }
          drawNativeStart = null;
          this.setDrawingTool('view');
        }
        return;
      }
      if (isPanning && e.button === 0) {
        isPanning = false;
        imgNode.style.cursor = (this.activeTool !== 'view' || this.isSnipMode) ? 'crosshair' : 'grab';
        if (renderFrame) { cancelAnimationFrame(renderFrame); renderFrame = null; }
      }
      if (isMarqueeZoom && e.button === 2) {
        isMarqueeZoom = false;
        marqueeNode.style.display = 'none';
        const wr = wrapNode.getBoundingClientRect();
        const endX = ByteInspector.clampValue(e.clientX - wr.left, 0, wr.width), endY = ByteInspector.clampValue(e.clientY - wr.top, 0, wr.height);
        const w = Math.abs(endX - sx), h = Math.abs(endY - sy);
        if (w > 20 && h > 20) {
          const curZ = this.pageZoomMap[pNo] || 100;
          const ratio = Math.min(wr.width / w, wr.height / h);
          const nextZ = ByteInspector.clampValue(curZ * ratio, UI_CONFIG.ZOOM_MIN, UI_CONFIG.ZOOM_MAX);
          const p = this.pagePanMap[pNo] || { x: 0, y: 0 };
          const nx = (p.x + (wr.width / 2 - (Math.min(sx, endX) + w / 2))) * (nextZ / curZ);
          const ny = (p.y + (wr.height / 2 - (Math.min(sy, endY) + h / 2))) * (nextZ / curZ);
          this.pagePanMap[pNo] = { x: nx, y: ny };
          this.pageFitModeMap[pNo] = null;
          this.updateZoom(pNo, nextZ, true);
        }
      }
    };

    wrapNode.addEventListener('contextmenu', e => e.preventDefault());
    wrapNode.addEventListener('wheel', onWheel, { passive: false });
    wrapNode.addEventListener('dblclick', (e) => {
      const pt = this.screenCoordToImageNative(e.clientX, e.clientY);
      if (pt) {
        const hit = this.hitTestAnnotation(pt);
        if (hit?.ann?.type === 'text') {
          this.openInlineTextEditor(hit.ann, e.clientX, e.clientY);
          return;
        }
      }
      this.setFitWidth(pNo);
    });
    wrapNode.addEventListener('mousedown', onMouseDown);
    window.addEventListener('mousemove', onMouseMove);
    window.addEventListener('mouseup', onMouseUp);

    this.canvasInteractDisposer = () => {
      if (renderFrame) cancelAnimationFrame(renderFrame);
      wrapNode.removeEventListener('wheel', onWheel);
      wrapNode.removeEventListener('mousedown', onMouseDown);
      window.removeEventListener('mousemove', onMouseMove);
      window.removeEventListener('mouseup', onMouseUp);
    };
  }

  async downloadRenderedPage() {
    this.executeManagedTask('準備下載畫面圖檔', async () => {
      const data = await this.ensurePageReady(this.activePageIndex);
      const { targetDoc, targetPageNo } = PreviewCanvasController.mapPageTarget(this.currentDocument, this.activePageIndex);
      const pk = this.getCurrentPageKey();
      const tr = await RasterProcessingEngine.transform(
        data, this.resolveAdjustments(targetDoc?.rowKey, targetPageNo),
        this.pageAnnotationsMap.get(pk) || [], this.pageLocalEnhanceMap.get(pk) || []
      );
      ByteInspector.executeBlobDownload(tr.name, tr.data, tr.ext);
    });
  }

  async downloadOriginalPage(pNo) {
    this.executeManagedTask('讀取原檔下載', async () => {
      const { targetDoc, targetPageNo } = PreviewCanvasController.mapPageTarget(this.currentDocument, pNo);
      if (!targetDoc) throw new Error('目標文件不存在');
      const item = {
        cacheNamespace: this.state.currentCaseNoRaw, docId: targetDoc.docId, currentPage: targetPageNo,
        totalPage: targetDoc.totalPages, mimeType: targetDoc.mimeType, formName: targetDoc.formName,
        rawName: `${this.state.currentCaseNoSafe}_${ByteInspector.truncateText(targetDoc.formId, 40)}_p${targetPageNo}`
      };
      const orig = await this.fetcher.acquireSingleImage(item, { useCache: true, purpose: 'original' });
      ByteInspector.executeBlobDownload(ByteInspector.sanitizeText(item.rawName) + orig.ext, orig.data, orig.ext);
    });
  }

  async printDocumentPages(options = {}) {
    const { signal, onProgress, printWin } = options;
    const doc = this.currentDocument;
    if (!doc) return;
    try {
      const list = [];
      for (let p = 1; p <= doc.totalPages; p++) {
        if (signal?.aborted) throw new DOMException('已取消列印', 'AbortError');
        const data = await this.ensurePageReady(p);
        const { targetDoc, targetPageNo } = PreviewCanvasController.mapPageTarget(doc, p);
        const pk = this.formatAdjustKey(targetDoc?.rowKey || '', targetPageNo);
        list.push(await RasterProcessingEngine.transform(
          data, this.resolveAdjustments(targetDoc?.rowKey, targetPageNo),
          this.pageAnnotationsMap.get(pk) || [], this.pageLocalEnhanceMap.get(pk) || []
        ));
        onProgress?.({ current: p, total: doc.totalPages, label: '準備列印頁面' });
      }
      const bundle = PrintDocumentEngine.composePrintTemplate(doc.formName, list);
      if (printWin && !printWin.closed) {
        printWin.document.open();
        printWin.document.write(bundle.htmlContent);
        printWin.document.close();
      }
    } catch (err) {
      if (printWin && !printWin.closed) {
        printWin.document.open();
        printWin.document.write(`<!doctype html><html><body style="font-family:sans-serif;padding:32px;text-align:center;"><h2>${signal?.aborted ? '已取消列印' : '列印失敗'}</h2><button onclick="window.close()">關閉</button></body></html>`);
        printWin.document.close();
      }
      throw err;
    }
  }

  async zipDocumentPages(options = {}) {
    const { signal, onProgress } = options;
    const doc = this.currentDocument;
    if (!doc) return;
    const files = [];
    for (let p = 1; p <= doc.totalPages; p++) {
      if (signal?.aborted) throw new DOMException('已取消打包', 'AbortError');
      const { targetDoc, targetPageNo } = PreviewCanvasController.mapPageTarget(doc, p);
      const item = {
        cacheNamespace: this.state.currentCaseNoRaw, docId: targetDoc.docId, currentPage: targetPageNo,
        totalPage: targetDoc.totalPages, mimeType: targetDoc.mimeType, formName: targetDoc.formName,
        rawName: `${this.state.currentCaseNoSafe}_${ByteInspector.truncateText(targetDoc.formId, 40)}_p${targetPageNo}`
      };
      files.push(await this.fetcher.acquireSingleImage(item, { signal, useCache: true, purpose: 'original' }));
      onProgress?.({ current: p, total: doc.totalPages, label: '讀取原檔封裝' });
    }
    await ZipArchiveEngine.compressAndEmit(`${this.state.currentCaseNoSafe}_${ByteInspector.truncateText(doc.formId, 40)}`, files, { signal });
  }
}

class CaseListController {
  constructor(appState, dataFetcher, onOpenViewer, onSelectionChanged, onQueryStart) {
    this.state = appState;
    this.fetcher = dataFetcher;
    this.onOpenViewer = onOpenViewer;
    this.onSelectionChanged = onSelectionChanged;
    this.onQueryStart = onQueryStart;

    this.querySessionId = 0;
    this.searchAbortCtrl = null;
    this.preloadAbortCtrl = null;
    this.relatedAbortCtrl = null;
    this.searchKeyword = '';
    this.selectedKeys = new Set();
    this.highlightedDocKey = null;
    this.activeSortKey = null;
    this.sortAscending = true;
    this.associatedList = [];

    this.containerNode = $id('list_container');
    this.selectAllCheckbox = $id('toggle_all');
    this.summaryNode = $id('selected_summary');
    this.filterInputNode = $id('filter_docs');
    this.associatedWrapNode = $id('related_cases_wrap');

    this.bindDomEvents();
  }

  destroy() {
    this.searchAbortCtrl?.abort();
    this.preloadAbortCtrl?.abort();
    this.relatedAbortCtrl?.abort();
  }

  bindDomEvents() {
    this.selectAllCheckbox?.addEventListener('change', () => {
      const visible = this.getFilteredRecords();
      const allSel = visible.every(d => this.selectedKeys.has(String(d.rowKey)));
      visible.forEach(doc => { if (allSel) this.selectedKeys.delete(String(doc.rowKey)); else this.selectedKeys.add(String(doc.rowKey)); });
      this.renderTable();
    });

    this.filterInputNode?.addEventListener('input', (e) => {
      this.searchKeyword = e.target.value.trim().toLowerCase();
      this.renderTable();
    });

    $id('select_filtered')?.addEventListener('click', () => {
      this.selectedKeys = new Set(this.getFilteredRecords().map(d => String(d.rowKey)));
      this.renderTable();
    });

    $id('invert_selection')?.addEventListener('click', () => {
      for (const doc of this.getFilteredRecords()) {
        const k = String(doc.rowKey);
        if (this.selectedKeys.has(k)) this.selectedKeys.delete(k); else this.selectedKeys.add(k);
      }
      this.renderTable();
    });

    ['formId', 'docId', 'formName', 'totalPages'].forEach((col) => {
      $id('th_' + col)?.addEventListener('click', () => {
        if (this.activeSortKey === col) this.sortAscending = !this.sortAscending;
        else { this.activeSortKey = col; this.sortAscending = true; }
        this.updateSortIndicators();
        this.renderTable();
      });
    });
  }

  updateSortIndicators() {
    ['formId', 'docId', 'formName', 'totalPages'].forEach((col) => {
      const btn = $id('th_' + col);
      if (!btn) return;
      const lbl = { formId: 'FormID', docId: 'DocID', formName: '文件名稱', totalPages: '頁數' }[col];
      btn.textContent = this.activeSortKey === col ? `${lbl} ${this.sortAscending ? '▲' : '▼'}` : lbl;
    });
  }

  getFilteredRecords() {
    let res = this.state.docGroupList;
    if (this.searchKeyword) {
      const kw = this.searchKeyword;
      res = res.filter(it => (String(it.formId || '') + String(it.docId || '') + String(it.formName || '') + String(it.annot || '')).toLowerCase().includes(kw));
    }
    if (this.activeSortKey) {
      const k = this.activeSortKey, asc = this.sortAscending;
      res = res.slice().sort((a, b) => {
        const va = a[k], vb = b[k];
        if (typeof va === 'string' || typeof vb === 'string') return asc ? String(va ?? '').localeCompare(String(vb ?? '')) : String(vb ?? '').localeCompare(String(va ?? ''));
        return asc ? (Number(va || 0) - Number(vb || 0)) : (Number(vb || 0) - Number(va || 0));
      });
    }
    return res;
  }

  renderAssociatedPills() {
    if (!this.associatedWrapNode) return;
    if (!this.associatedList.length) {
      this.associatedWrapNode.style.display = 'none';
      this.associatedWrapNode.innerHTML = '';
      return;
    }
    const cid = this.state.currentClientId;
    const masked = cid.length > 4 ? (cid.slice(0, 3) + '****' + cid.slice(-2)) : cid;

    let tpl = `<div class="iw-related-header">
      <div style="display:flex;align-items:center;gap:6px;min-width:0;overflow:hidden;">
        <span style="font-weight:700;color:var(--iw-primary);white-space:nowrap;">🔗 客戶關聯案件</span>
        <span class="iw-badge" style="font-size:10px;padding:1px 6px;">ID: ${ByteInspector.escapeXml(masked || '--')}</span>
      </div>
      <span style="font-size:10px;color:var(--iw-text-muted);flex-shrink:0;">共 ${this.associatedList.length} 筆受理案號</span>
    </div><div class="iw-related-pills">`;

    this.associatedList.forEach((item) => {
      const isCur = String(item.caseNo) === String(this.state.currentCaseNoRaw);
      tpl += `<button class="iw-case-pill ${isCur?'active':''}" data-case="${ByteInspector.escapeXml(item.caseNo)}" type="button">
        <span>${ByteInspector.escapeXml(item.caseNo)}</span>
        <span class="pill-pages">${item.totalPages}p</span>
      </button>`;
    });
    tpl += '</div>';

    this.associatedWrapNode.innerHTML = tpl;
    this.associatedWrapNode.style.display = 'block';
    this.associatedWrapNode.querySelectorAll('.iw-case-pill').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const target = btn.dataset.case;
        if (target && target !== this.state.currentCaseNoRaw) {
          const inp = $id('input_caseno');
          if (inp) inp.value = target;
          this.executeSearch(target);
        }
      });
    });
  }

  renderTable() {
    if (!this.containerNode) return;
    const records = this.getFilteredRecords();
    if (!records.length) {
      this.containerNode.innerHTML = '<div style="text-align:center;color:var(--iw-text-muted);padding:30px 16px;font-size:12px;">🔍 查無符合條件之文件</div>';
      this.updateSelectionSummary();
      return;
    }

    const frag = document.createDocumentFragment();
    if (!this.searchKeyword && this.state.docGroupList.length > 1) {
      const allPages = this.state.docGroupList.reduce((sum, d) => sum + d.totalPages, 0);
      const isAllActive = this.highlightedDocKey === '__ALL__';
      const allRow = document.createElement('div');
      allRow.className = 'iw-list-row ' + (isAllActive ? 'active' : '');
      Object.assign(allRow.style, {
        borderColor: 'var(--iw-primary)',
        background: 'var(--iw-primary-light)',
        marginBottom: '3px',
        borderLeft: '4px solid var(--iw-primary)'
      });
      allRow.dataset.rowKey = '__ALL__';
      allRow.setAttribute('role', 'button');
      allRow.setAttribute('tabindex', '0');
      allRow.innerHTML = `<span></span><span class="iw-tag-id" style="background:var(--iw-primary);color:var(--iw-primary-text);font-weight:800;">ALL</span><span class="iw-tag-id" style="color:var(--iw-primary);width:auto;">全案總覽</span><div style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:700;color:var(--iw-text-main);">📋 本案全部文件總覽</div><span style="color:var(--iw-primary);font-size:11px;text-align:right;font-weight:700;">${allPages} 頁</span>`;

      const onAll = () => {
        this.highlightedDocKey = '__ALL__';
        this.updateRowHighlight();
        this.onOpenViewer?.(ByteInspector.buildVirtualAllCaseDocument(this.state.docGroupList), 1, false);
      };
      allRow.addEventListener('click', onAll);
      allRow.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); onAll(); } });
      frag.appendChild(allRow);
    }

    records.forEach((doc) => {
      const isChecked = this.selectedKeys.has(String(doc.rowKey));
      const isActive = this.highlightedDocKey === String(doc.rowKey);

      const row = document.createElement('div');
      row.className = 'iw-list-row ' + (isActive ? 'active' : '');
      row.dataset.rowKey = String(doc.rowKey);
      row.setAttribute('role', 'button');
      row.setAttribute('tabindex', '0');

      const cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.checked = isChecked;
      cb.style.accentColor = 'var(--iw-primary)';
      cb.style.cursor = 'pointer';
      cb.addEventListener('click', e => e.stopPropagation());
      cb.addEventListener('change', () => {
        if (cb.checked) this.selectedKeys.add(String(doc.rowKey)); else this.selectedKeys.delete(String(doc.rowKey));
        this.updateSelectionSummary();
      });

      const fBadge = document.createElement('span');
      fBadge.className = 'iw-tag-id'; fBadge.textContent = doc.formId;
      const dBadge = document.createElement('span');
      dBadge.className = 'iw-tag-id'; dBadge.style.color = 'var(--iw-primary)'; dBadge.textContent = doc.docId;

      const txtWrap = document.createElement('div');
      Object.assign(txtWrap.style, {
        minWidth: '0',
        display: 'flex',
        alignItems: 'center',
        gap: '4px',
        overflow: 'hidden'
      });
      const nameLbl = document.createElement('span');
      Object.assign(nameLbl.style, {
        color: 'var(--iw-text-main)',
        fontSize: '12px',
        fontWeight: '700',
        overflow: 'hidden',
        textOverflow: 'ellipsis',
        whiteSpace: 'nowrap'
      });
      nameLbl.textContent = doc.formName;
      txtWrap.appendChild(nameLbl);

      const pCount = document.createElement('span');
      Object.assign(pCount.style, {
        color: 'var(--iw-text-muted)',
        fontSize: '11px',
        textAlign: 'right',
        fontWeight: '700',
        whiteSpace: 'nowrap'
      });
      pCount.textContent = doc.totalPages + ' 頁';

      const onSel = () => {
        this.highlightedDocKey = String(doc.rowKey);
        this.updateRowHighlight();
        this.onOpenViewer?.(doc, 1, false);
      };
      row.addEventListener('click', onSel);
      row.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); onSel(); } });
      row.append(cb, fBadge, dBadge, txtWrap, pCount);
      frag.appendChild(row);
    });

    this.containerNode.innerHTML = '';
    this.containerNode.appendChild(frag);
    this.updateSelectionSummary();
  }

  updateRowHighlight() {
    this.containerNode?.querySelectorAll('.iw-list-row').forEach((r) => {
      r.classList.toggle('active', r.dataset.rowKey === this.highlightedDocKey);
    });
  }

  updateSelectionSummary() {
    let total = 0;
    for (const doc of this.state.docGroupList) {
      if (this.selectedKeys.has(String(doc.rowKey))) total += doc.totalPages;
    }
    if (this.summaryNode) {
      this.summaryNode.innerHTML = `已選 <b style="color:var(--iw-primary);font-weight:800;">${this.selectedKeys.size}</b> 份 (<b style="color:var(--iw-primary);font-weight:800;">${total}</b> 頁)`;
    }
    if (this.selectAllCheckbox) {
      const visible = this.getFilteredRecords();
      const chkCount = visible.filter(d => this.selectedKeys.has(String(d.rowKey))).length;
      this.selectAllCheckbox.checked = visible.length > 0 && chkCount === visible.length;
      this.selectAllCheckbox.indeterminate = chkCount > 0 && chkCount < visible.length;
    }
    this.onSelectionChanged?.(this.selectedKeys.size > 0);
  }

  async executeSearch(caseNumberRaw) {
    const rawVal = String(caseNumberRaw || '').trim();
    if (!rawVal) return;
    this.onQueryStart?.(rawVal);

    const token = ++this.querySessionId;
    this.searchAbortCtrl?.abort();
    this.preloadAbortCtrl?.abort();
    this.relatedAbortCtrl?.abort();
    this.searchAbortCtrl = new AbortController();

    this.state.currentCaseNoRaw = rawVal;
    this.state.currentCaseNoSafe = ByteInspector.sanitizeText(rawVal) || 'Case_Files';
    this.state.docGroupList = [];
    this.state.currentClientId = '';
    this.selectedKeys.clear();

    if (this.containerNode) {
      this.containerNode.innerHTML = '<div style="text-align:center;color:var(--iw-primary);padding:30px 16px;font-weight:700;"><div>⏳</div><div>檢索案件清單中...</div></div>';
    }

    const resp = await this.fetcher.queryCaseIndex(rawVal, { signal: this.searchAbortCtrl.signal });
    if (token !== this.querySessionId || resp.aborted) return;

    if (resp.errorMessage) {
      this.containerNode.innerHTML = `<div style="text-align:center;color:var(--iw-danger);padding:30px 12px;font-size:12px;font-weight:700;"><div>⚠️</div><div>${ByteInspector.escapeXml(resp.errorMessage)}</div></div>`;
      this.updateSelectionSummary();
      return;
    }

    this.state.docGroupList = resp.docGroupList;
    this.state.currentClientId = resp.clientId || '';
    this.selectedKeys = new Set(resp.docGroupList.map(d => String(d.rowKey)));
    this.renderTable();

    if (resp.docGroupList.length > 0) {
      const isMulti = resp.docGroupList.length > 1;
      this.highlightedDocKey = isMulti ? '__ALL__' : String(resp.docGroupList[0].rowKey);
      this.updateRowHighlight();
      this.onOpenViewer?.(isMulti ? ByteInspector.buildVirtualAllCaseDocument(resp.docGroupList) : resp.docGroupList[0], 1, false);
      this.startPreloadQueue(resp.docGroupList, token);
    }
    if (this.state.currentClientId) this.startAssociatedCasesFetch(this.state.currentClientId, token);
  }

  startAssociatedCasesFetch(clientId, sessionToken) {
    this.relatedAbortCtrl = new AbortController();
    const sig = this.relatedAbortCtrl.signal;
    this.fetcher.queryAssociatedCases(clientId, { signal: sig }).then((list) => {
      if (sessionToken !== this.querySessionId || sig.aborted) return;
      this.associatedList = list;
      this.renderAssociatedPills();
    }).catch(() => {});
  }

  startPreloadQueue(records, sessionToken) {
    this.preloadAbortCtrl?.abort();
    this.preloadAbortCtrl = new AbortController();
    const sig = this.preloadAbortCtrl.signal;

    const queue = [];
    for (const doc of records) {
      for (let p = 1; p <= doc.totalPages; p++) {
        queue.push({
          cacheNamespace: this.state.currentCaseNoRaw, docId: doc.docId, currentPage: p,
          totalPage: doc.totalPages, mimeType: doc.mimeType, formName: doc.formName,
          rawName: `${this.state.currentCaseNoSafe}_${ByteInspector.truncateText(doc.formId, 40)}_p${p}`
        });
      }
    }

    const pBar = $id('batch_progress_bar'), sTxt = $id('batch_status_text'), pTxt = $id('batch_percent_text');
    let completed = 0;
    const updateUi = () => {
      if (sessionToken !== this.querySessionId || sig.aborted) return;
      const pct = Math.round((completed / queue.length) * 100);
      if (pBar) { pBar.style.width = pct + '%'; pBar.style.background = pct >= 100 ? 'var(--iw-success)' : 'var(--iw-primary)'; }
      if (pTxt) pTxt.textContent = pct + '%';
      if (sTxt) {
        sTxt.textContent = pct >= 100 ? '預載完成 100%' : `預載中 ${pct}% (${completed}/${queue.length})`;
        sTxt.style.color = pct >= 100 ? 'var(--iw-success)' : 'var(--iw-text-muted)';
      }
    };
    updateUi();
    ByteInspector.poolExecutor(SYSTEM_LIMITS.PREVIEW_CONCURRENCY, queue, async (item) => {
      if (sig.aborted || sessionToken !== this.querySessionId) return;
      try { await this.fetcher.acquireSingleImage(item, { signal: sig, useCache: true, purpose: 'preview' }); } catch (_) {}
      finally { completed++; updateUi(); }
    });
  }

  collectSelectedQueue() {
    const queue = [];
    for (const doc of this.state.docGroupList) {
      if (!this.selectedKeys.has(String(doc.rowKey))) continue;
      for (let p = 1; p <= doc.totalPages; p++) {
        queue.push({
          rowKey: doc.rowKey, docId: doc.docId, currentPage: p, totalPage: doc.totalPages,
          mimeType: doc.mimeType, formName: doc.formName,
          rawName: `${this.state.currentCaseNoSafe}_${ByteInspector.truncateText(doc.formId, 40)}_${ByteInspector.truncateText(doc.formName, 80)}_p${p}`
        });
      }
    }
    return queue;
  }
}

