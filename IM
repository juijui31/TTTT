      else if (hasPdf && !hasJpg && !hasPng && !hasTif) pushU('.pdf');
      else { if (hasJpg) pushU('.jpg'); if (hasPng) pushU('.png'); if (hasTif) pushU('.tif'); if (hasPdf) pushU('.pdf'); }
    } else {
      if (hasPdf) pushU('.pdf');
      if (hasTif) { pushU('.jpg'); pushU('.png'); pushU('.tif'); }
      else { if (hasJpg) pushU('.jpg'); if (hasPng) pushU('.png'); if (hasTif) pushU('.tif'); }
