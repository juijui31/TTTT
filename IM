  async retrieveImageStream(item, extTarget, options = {}) {
    const signal = options.signal;
    const routes = EndpointMapper.getDocumentEndpoints();
    const urlBuild = (bp) => `${bp}?currentPage=${item.currentPage}&totalPage=${item.totalPage}&docId=${encodeURIComponent(item.docId)}&mimeType=${encodeURIComponent(item.mimeType)}&fileExtension=${encodeURIComponent(extTarget)}&random=${Date.now()}`;
    const reqHeaders = { method: 'GET', headers: { accept: '*/*', 'x-requested-with': 'XMLHttpRequest' }, credentials: 'include' };

    for (const baseRoute of [routes.primaryImage, routes.secondaryImage]) {
      try {
        const resp = await this.sendRequestWithTimeout(urlBuild(baseRoute), reqHeaders, signal);
        if (resp.status === 401 || resp.status === 403) return { error: 'AUTH_REQUIRED', retry: false };
        if (!resp.ok) {
          if ([404, 405].includes(resp.status)) continue;
          return { error: 'HTTP_' + resp.status, retry: [400, 404, 405, 415, 422].includes(resp.status) };
        }
        const ct = resp.headers.get('content-type') || '';
        if (ct.includes('text/html')) return { error: 'AUTH_HTML_RESPONSE', retry: false };
        const arrayBuf = await resp.arrayBuffer();
        if (arrayBuf.byteLength === 0) return { error: '0 Byte', retry: true };
        const u8 = new Uint8Array(arrayBuf);
        const actualFormat = ByteInspector.sniffExtension(u8);
        if (!actualFormat) return { error: 'INVALID_SIGNATURE', retry: true };
        return { data: { data: u8, ext: actualFormat }, retry: false };
      } catch (err) {
        if (RemoteDataFetcher.isAbort(err) || signal?.aborted) throw err;
      }
    }
