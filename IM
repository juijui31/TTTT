    this.abortSignals = new Set();
  }
  fetchCached(k) {
    if (!this.lruCache.has(k)) return null;
    const v = this.lruCache.get(k);
    this.lruCache.delete(k);
    this.lruCache.set(k, v);
    return v;
  }
