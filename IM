    let mime = raw?.MimeType ?? raw?.mimeType ?? '';
    if (typeof mime !== 'string' || !mime.trim()) mime = '.jpg|.tif';
    return {
      rowKey: idx + '_' + String(docId),
      idx,
      docId: String(docId),
      formId: String(raw?.FormID ?? raw?.formId ?? '未提供'),
      formName: String(raw?.FormName ?? raw?.formName ?? ('文件_' + (idx + 1))),
